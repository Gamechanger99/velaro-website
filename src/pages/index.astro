---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Velaro — Street Food Catering & Foodtruck" description="Street-Food-Catering aus Haldensleben — frisch, laut, lecker. Foodtruck-Energie für jedes Event.">

  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <div class="hero-bg">
      <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?q=80&w=2400&auto=format&fit=crop" alt="Velaro Foodtruck Action" />
    </div>
    <div class="container hero-grid">
      <div class="hero-text">
        <div class="hero-eyebrow-row">
          <span class="eyebrow"><span class="dot"></span> Catering aus Haldensleben</span>
          <span class="eyebrow eyebrow--teal">Catering · Foodtruck · Marktstand</span>
        </div>
        <h1>
          <span class="line"><span>Hungrig?</span></span>
          <span class="line"><span class="stroke">Gut so.</span></span>
          <span class="line"><span class="hot">Wir kochen.</span></span>
        </h1>
        <p class="hero-desc">
          Frisch gegrillt, frisch gekocht, mit Liebe serviert. Vom Bauernmarkt
          bis zur Firmenfeier — wir bringen unsere Küche zu euch.
        </p>
        <div class="hero-cta">
          <a href="/catering" class="btn btn-primary">Speisekarte ansehen <span class="arrow">→</span></a>
          <a href="/kontakt" class="btn btn-outline">Foodtruck anfragen</a>
        </div>
      </div>

      <div class="hero-stickers">
        <div class="big-sticker">
          <span class="small">Seit</span>
          <span class="num">2012</span>
        </div>
        <div class="big-sticker bs-teal">
          <span class="small">400+ Events</span>
          <span class="num">100%</span>
          <span class="small" style="margin-top: 0.4rem;">Regional · Frisch</span>
        </div>
        <div class="big-sticker bs-mustard">
          <span class="small">Bewertung</span>
          <span class="num">★★★★★</span>
        </div>
      </div>
    </div>

    <div class="scroll-hint">
      Schaut weiter, das Beste kommt noch
    </div>
  </section>

  <!-- ═══════════ MARQUEE ═══════════ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>★ Burger ★ Grillbuffet ★ Canapés ★ Foodtruck ★ Hochzeiten ★ Firmenfeiern ★ Marktstände ★ Pulled Pork ★ Loaded Fries ★ Hausgemacht ★</span>
      <span>★ Burger ★ Grillbuffet ★ Canapés ★ Foodtruck ★ Hochzeiten ★ Firmenfeiern ★ Marktstände ★ Pulled Pork ★ Loaded Fries ★ Hausgemacht ★</span>
    </div>
  </div>

  <!-- ═══════════ FEATURES ═══════════ -->
  <section class="features bg-cream">
    <div class="container">
      <div class="feat-head reveal">
        <h2>Zwei <span class="hand">Welten</span>,<br/>ein Hunger.</h2>
        <p class="right">Ob auf der Hochzeit oder mittendrin auf dem Markt — bei uns kriegt ihr dasselbe ehrliche Essen. Nur das Drumherum ändert sich.</p>
      </div>

      <div class="feat-grid reveal-stagger">

        <a href="/catering" class="feat-card">
          <img src="https://images.unsplash.com/photo-1555244162-803834f70033?q=80&w=1600&auto=format&fit=crop" alt="Catering Buffet" />
          <span class="corner-sticker">Ab 10<br/>Pers.</span>
          <div class="feat-body">
            <span class="feat-tag">— 01 · Catering &amp; Buffet</span>
            <h3>Volle Tische,<br/>volle <span class="hand">Bäuche</span>.</h3>
            <p>Klassisches Buffet, Grill, Foodtruck oder Fingerfood — komplett auf euren Anlass abgestimmt. Wir kommen, wir kochen, wir räumen ab.</p>
            <span class="feat-link">Banketmappe öffnen →</span>
          </div>
        </a>

        <a href="/maerkte" class="feat-card">
          <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?q=80&w=1600&auto=format&fit=crop" alt="Food Truck auf dem Markt" />
          <span class="corner-sticker" style="background: var(--accent); transform: rotate(-10deg);">Frisch<br/>vom<br/>Truck</span>
          <div class="feat-body">
            <span class="feat-tag tag-teal">— 02 · Markt &amp; Truck</span>
            <h3>Frisch vom Grill,<br/>direkt <span class="hand">zu euch</span>.</h3>
            <p>Findet uns auf Stadtfesten, Bauernmärkten und Sommerfesten. Frische Burger, knusprige Pommes — alles, was den Tag besser macht.</p>
            <span class="feat-link fl-teal">Termine ansehen →</span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- ═══════════ ABOUT (cream → navy tear) ═══════════ -->
  <section class="about-section bg-cream torn-bottom torn-navy">
    <div class="container about-grid">
      <div class="about-media reveal">
        <div class="img-frame">
          <img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?q=80&w=1400&auto=format&fit=crop" alt="Köche in Action" />
        </div>
        <div class="floating-sticker">
          <span class="num">12+</span>
          <span class="lbl">Jahre am Herd</span>
        </div>
      </div>
      <div class="about-text reveal">
        <span class="eyebrow eyebrow--teal">Hinter den Kulissen</span>
        <h2 style="margin-top: 1.5rem;">Kein Catering<br/>von der <span class="hand">Stange</span>.</h2>
        <p>
          Velaro startete 2012 mit einem Foodtruck, einem alten Grill und
          der festen Idee: gutes Essen muss ehrlich sein. Frisch, regional,
          und mit Liebe gekocht.
        </p>
        <p>
          Heute bewegen wir uns zwischen Bauernmarkt und Firmen-Bankett —
          aber die Haltung ist die gleiche geblieben. Wir kochen, was wir
          selbst essen würden. Und wir freuen uns, wenn ihr Fragen habt.
        </p>
        <div class="about-stats">
          <div class="s"><div class="k">12+</div><div class="l">Jahre</div></div>
          <div class="s"><div class="k">400+</div><div class="l">Events</div></div>
          <div class="s"><div class="k">100%</div><div class="l">Frisch</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ VALUES (navy) ═══════════ -->
  <section class="values bg-navy">
    <div class="container">
      <div class="values-head reveal">
        <div>
          <span class="eyebrow">Was uns ausmacht</span>
          <h2 style="margin-top: 1.5rem; color: var(--cream);">Drei Versprechen,<br/>die bei uns <span class="hand">nicht verhandelbar</span> sind.</h2>
        </div>
      </div>

      <div class="values-grid reveal-stagger">
        <div class="value">
          <span class="num">01</span>
          <h3>Frisch &amp; regional</h3>
          <p>Zutaten kommen vom Markt nebenan, nicht aus der Tiefkühle. Was nicht regional geht, beziehen wir von Erzeugern, die wir persönlich kennen.</p>
        </div>
        <div class="value">
          <span class="num">02</span>
          <h3>Maßgeschneidert</h3>
          <p>Jedes Event ist anders. Wir stimmen Menü, Setup und Service genau auf eure Gäste ab — von 10 bis 500 Personen.</p>
        </div>
        <div class="value">
          <span class="num">03</span>
          <h3>Verlässlich vor Ort</h3>
          <p>Wir kommen vor Plan. Wir bauen zügig auf. Wir räumen leise ab. Keine Überraschungen — außer auf dem Teller.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ MARQUEE 2 (teal) ═══════════ -->
  <div class="marquee marquee--teal" aria-hidden="true">
    <div class="marquee-track">
      <span>HAUSGEMACHT · HANDGEMACHT · FRISCH · EHRLICH <span class="star"></span> HAUSGEMACHT · HANDGEMACHT · FRISCH · EHRLICH <span class="star"></span> HAUSGEMACHT · HANDGEMACHT · FRISCH · EHRLICH <span class="star"></span></span>
      <span>HAUSGEMACHT · HANDGEMACHT · FRISCH · EHRLICH <span class="star"></span> HAUSGEMACHT · HANDGEMACHT · FRISCH · EHRLICH <span class="star"></span> HAUSGEMACHT · HANDGEMACHT · FRISCH · EHRLICH <span class="star"></span></span>
    </div>
  </div>

  <!-- ═══════════ INSTAGRAM ═══════════ -->
  <section class="ig-section bg-navy">
    <div class="container">
      <div class="ig-head reveal">
        <div>
          <span class="eyebrow">@velaro_cateringundfoodtruck</span>
          <h2 style="margin-top: 1.25rem;">Schaut bei uns<br/>auf <span class="hand">Instagram</span> vorbei.</h2>
          <div class="ig-handle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            Neue Termine · Frische Gerichte · Hinter den Kulissen
          </div>
        </div>
        <a href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener" class="btn btn-primary">
          Profil ansehen <span class="arrow">→</span>
        </a>
      </div>

      <!-- TODO: echte IG-Bilder von @velaro_cateringundfoodtruck einfügen -->
      <div class="ig-grid reveal-stagger">
        <a class="ig-tile ig-tile--big" href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener"><img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?q=80&w=1200&auto=format&fit=crop" alt="TODO: echtes IG-Bild" /></a>
        <a class="ig-tile ig-tile--tall" href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener"><img src="https://images.unsplash.com/photo-1606755962773-d324e0a13086?q=80&w=900&auto=format&fit=crop" alt="TODO: echtes IG-Bild" /></a>
        <a class="ig-tile" href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener"><img src="https://images.unsplash.com/photo-1559054663-e8d23213f55c?q=80&w=800&auto=format&fit=crop" alt="TODO: echtes IG-Bild" /></a>
        <a class="ig-tile" href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener"><img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?q=80&w=800&auto=format&fit=crop" alt="TODO: echtes IG-Bild" /></a>
        <a class="ig-tile ig-tile--wide" href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener"><img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=1200&auto=format&fit=crop" alt="TODO: echtes IG-Bild" /></a>
        <a class="ig-tile ig-tile--tall" href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener"><img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?q=80&w=800&auto=format&fit=crop" alt="TODO: echtes IG-Bild" /></a>
        <a class="ig-tile" href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener"><img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?q=80&w=800&auto=format&fit=crop" alt="TODO: echtes IG-Bild" /></a>
        <a class="ig-tile" href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener"><img src="https://images.unsplash.com/photo-1432139509613-5c4255815697?q=80&w=800&auto=format&fit=crop" alt="TODO: echtes IG-Bild" /></a>
      </div>
    </div>
  </section>

  <!-- ═══════════ BIG CTA ═══════════ -->
  <section class="cta-band">
    <div class="container reveal">
      <span class="eyebrow eyebrow--teal center">Plant ihr ein Event?</span>
      <h2 style="margin-top: 1.25rem;">Sagt uns Bescheid,<br/>wir freuen <span class="hand">uns</span>.</h2>
      <p>
        Erzählt uns von eurem Anlass — wir melden uns innerhalb von 24 Stunden
        mit einem maßgeschneiderten Vorschlag und ein paar Ideen aus der Küche.
      </p>
      <div class="btns">
        <a href="/catering" class="btn btn-primary">Banketmappe öffnen <span class="arrow">→</span></a>
        <a href="/kontakt" class="btn btn-outline">Direkt anfragen</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ───── HERO ───── */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: clamp(7rem, 12vw, 9rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--navy);
    color: var(--cream);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-bg img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
    filter: contrast(1.05) saturate(1.15);
    animation: heropan 18s ease-in-out infinite alternate;
  }
  @keyframes heropan {
    from { transform: scale(1.08) translate(-1%, 0.5%); }
    to   { transform: scale(1.18) translate(1%, -0.5%); }
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(8,17,29,0.55) 0%, rgba(8,17,29,0.25) 35%, rgba(8,17,29,0.85) 90%),
      linear-gradient(90deg, rgba(8,17,29,0.85) 0%, rgba(8,17,29,0.3) 40%, transparent 70%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: end;
    min-height: 70vh;
  }
  .hero-eyebrow-row {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 1.8rem;
  }
  .hero h1 {
    color: var(--cream);
    font-size: clamp(3.5rem, 10vw, 9rem);
    line-height: 0.9;
    margin-bottom: 1.5rem;
  }
  .hero h1 .line { display: block; white-space: nowrap; }
  .hero h1 .line span { display: inline-block; }
  .hero h1 .stroke {
    -webkit-text-stroke: 3px var(--cream);
    color: transparent;
    letter-spacing: -0.01em;
  }
  .hero h1 .hot {
    color: var(--hot);
    display: inline-block;
    transform: rotate(-2deg);
  }
  .hero-desc {
    max-width: 480px;
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--text-2);
    margin-bottom: 2rem;
    font-weight: 500;
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-cta .btn { box-shadow: 6px 6px 0 var(--ink); }
  .hero-cta .btn:hover { box-shadow: 10px 10px 0 var(--ink); }

  .hero-stickers {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.2rem;
    padding-bottom: 0.5rem;
  }
  .big-sticker {
    background: var(--hot);
    color: var(--cream);
    border: 4px solid var(--cream);
    padding: 1.5rem 1.4rem;
    font-family: var(--display);
    font-size: 1.6rem;
    line-height: 0.95;
    text-transform: uppercase;
    transform: rotate(5deg);
    box-shadow: 6px 6px 0 var(--ink);
    max-width: 240px;
    letter-spacing: 0.02em;
  }
  .big-sticker.bs-teal { background: var(--accent); color: var(--navy-deep); transform: rotate(-4deg); }
  .big-sticker.bs-mustard { background: var(--mustard); color: var(--ink); transform: rotate(2deg); }
  .big-sticker .small {
    display: block;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-bottom: 0.5rem;
  }
  .big-sticker .num {
    font-size: 3.5rem;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  @media (max-width: 920px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-stickers { flex-direction: row; align-items: flex-start; flex-wrap: wrap; }
    .big-sticker { max-width: none; flex: 1 1 180px; padding: 1rem; font-size: 1.2rem; }
    .big-sticker .num { font-size: 2.4rem; }
  }

  .scroll-hint {
    position: absolute;
    bottom: 1rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--hand);
    font-size: 1rem;
    color: var(--hot);
    transform: rotate(-4deg);
  }
  @media (max-width: 700px) { .scroll-hint { display: none; } }

  /* ───── FEATURES — two poster cards ───── */
  .features {
    padding-block: clamp(4rem, 8vw, 7rem);
    position: relative;
  }
  .feat-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: 3rem;
  }
  .feat-head h2 { font-size: clamp(2.5rem, 7vw, 6rem); max-width: 12ch; }
  .feat-head h2 .hand { color: var(--hot); }
  .feat-head .right {
    max-width: 38ch;
    font-size: 1rem;
    line-height: 1.5;
    align-self: end;
    justify-self: end;
  }

  .feat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .feat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 540px;
    border: 4px solid var(--ink);
    background: var(--ink);
    overflow: hidden;
    cursor: pointer;
    transition: transform var(--t-snap);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .feat-card:hover {
    transform: translate(-4px, -4px) rotate(-0.5deg);
    box-shadow: 14px 14px 0 var(--hot);
  }
  .feat-card img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(.3,1.3,.4,1), filter var(--t);
    filter: contrast(1.1) saturate(1.2);
  }
  .feat-card:hover img { transform: scale(1.06); }
  .feat-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8,17,29,0) 35%, rgba(8,17,29,0.55) 65%, rgba(8,17,29,0.95) 100%);
  }
  .feat-body {
    position: relative;
    z-index: 2;
    padding: 2rem 2.25rem 2.25rem;
  }
  .feat-tag {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    background: var(--hot);
    color: var(--cream);
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    transform: rotate(-2deg);
  }
  .feat-tag.tag-teal { background: var(--accent); color: var(--navy-deep); }
  .feat-card h3 {
    color: var(--cream);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.88;
    margin-bottom: 0.75rem;
  }
  .feat-card h3 .hand { color: var(--hot); }
  .feat-card p {
    color: var(--cream);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 38ch;
    margin-bottom: 1.5rem;
    opacity: 0.92;
  }
  .feat-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cream);
    padding: 0.85rem 1.25rem;
    background: var(--hot);
    border: 3px solid var(--cream);
    transition: all var(--t-snap);
  }
  .feat-card:hover .feat-link {
    background: var(--cream);
    color: var(--ink);
  }
  .feat-link.fl-teal { background: var(--accent); color: var(--navy-deep); }
  .feat-card:hover .feat-link.fl-teal { background: var(--cream); color: var(--navy-deep); }

  .feat-card .corner-sticker {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 3;
    width: 90px; height: 90px;
    border-radius: 50%;
    background: var(--mustard);
    color: var(--ink);
    border: 4px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--display);
    font-size: 1rem;
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    transform: rotate(12deg);
    animation: wobble 4s ease-in-out infinite;
  }
  @keyframes wobble {
    0%,100% { transform: rotate(12deg); }
    50%     { transform: rotate(-6deg) scale(1.05); }
  }

  @media (max-width: 760px) {
    .feat-grid { grid-template-columns: 1fr; }
    .feat-card { min-height: 420px; }
    .feat-head { grid-template-columns: 1fr; }
    .feat-head .right { justify-self: start; }
  }

  /* ───── ABOUT split ───── */
  .about-section {
    padding-block: clamp(4rem, 9vw, 8rem);
    position: relative;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 1.2fr;
    gap: 4rem;
    align-items: center;
  }
  .about-media { position: relative; }
  .about-media .img-frame {
    position: relative;
    aspect-ratio: 4/5;
    border: 4px solid var(--ink);
    overflow: hidden;
    transform: rotate(-2deg);
    box-shadow: 10px 10px 0 var(--ink);
  }
  .about-media .img-frame img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(1.08) saturate(1.15);
  }
  .about-media .floating-sticker {
    position: absolute;
    bottom: -1.5rem;
    right: -1.5rem;
    background: var(--hot);
    color: var(--cream);
    border: 4px solid var(--ink);
    padding: 1rem 1.25rem;
