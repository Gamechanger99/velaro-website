---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Velaro Catering & Foodtruckservice – Willkommen">

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-top">
        <h1 class="stagger">Frisch gekocht, zu euch <span class="it">gebracht.</span></h1>
        <div class="hero-side reveal" data-d="3">
          <p>Catering, Foodtruck und Marktstand aus einer Hand. Regional eingekauft und frisch zubereitet.</p>
          <div class="hero-cta">
            <a href="/catering" class="btn btn-primary"><span>Catering anfragen</span> <span class="arr">→</span></a>
            <a href="/kontakt" class="btn btn-ghost"><span>Kontakt aufnehmen</span></a>
          </div>
        </div>
      </div>

      <div class="hero-strip reveal" data-d="4">
        <div class="it2"><span class="n">2026</span><span class="l">im Einsatz seit</span></div>
        <div class="it2"><span class="n">24 <small>h</small></span><span class="l">Angebot verbindlich</span></div>
        <div class="it2"><span class="n">100 <small>%</small></span><span class="l">regional &amp; frisch</span></div>
      </div>

    </div>
  </section>

  <!-- LEISTUNGEN -->
  <section class="block" id="leistungen">
    <div class="wrap">
      <div class="label-row reveal"><span class="ix">01</span><span class="tt">Was wir anbieten</span><span class="ln"></span></div>
      <div class="sec-head">
        <h2 class="reveal">Zwei Wege, wie wir <span class="it">zu euch</span> kommen.</h2>
        <p class="aside reveal" data-d="1">Ob privat, geschäftlich oder mitten auf dem Marktplatz — Umfang und Aufbau passen wir an euren Anlass an.</p>
      </div>
      <div class="offers-grid">
        <a href="/catering" class="offer-card lift reveal">
          <div class="offer-icon">🍽️</div>
          <h3>Catering &amp; Buffet</h3>
          <p>Individuelle Menüs für Events jeder Größe — vom Grillbuffet bis zu feinen Canapés. Frisch zubereitet am Eventtag, inklusive Aufbau und Service nach Wunsch.</p>
          <span class="offer-link">Zum Catering <span class="arr">→</span></span>
        </a>
        <a href="/maerkte" class="offer-card lift reveal" data-d="1">
          <div class="offer-icon">🚚</div>
          <h3>Foodtruck &amp; Märkte</h3>
          <p>Velaro unterwegs — frisch gekocht direkt vom Truck auf Märkten und Events in der Region. Kommt vorbei und probiert euch durch.</p>
          <span class="offer-link">Zu den Märkten <span class="arr">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section class="ig-section">
    <div class="wrap">
      <h2 class="ig-title reveal">Folgt uns auf <span class="it">Instagram</span></h2>
      <div class="ig-widget reveal" data-d="1">
        <script is:inline src="https://elfsightcdn.com/platform.js" async></script>
        <div class="elfsight-app-f5197244-2f87-4ce1-abcb-b3effb647ce1" data-elfsight-app-lazy></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band">
    <div class="wrap">
      <div class="cta-box reveal">
        <h2>Erzählt uns von <span class="it">eurem</span> Anlass.</h2>
        <p>Frage, Wunsch oder einfach „Hallo, könnt ihr nächsten Samstag?" — wir melden uns binnen 24 Stunden mit einem persönlichen Angebot.</p>
        <div class="row">
          <a href="/kontakt" class="btn btn-primary"><span>Anfrage senden</span> <span class="arr">→</span></a>
        </div>
      </div>
    </div>
  </section>

<script>
  const DURATION = 1600;
  function easeOut(t: number) { return 1 - Math.pow(1 - t, 3); }

  function animateCount(textNode: Text, from: number, to: number) {
    const start = performance.now();
    function step(now: number) {
      const p = Math.min((now - start) / DURATION, 1);
      textNode.nodeValue = String(Math.round(from + (to - from) * easeOut(p)));
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  const strip = document.querySelector('.hero-strip');
  if (strip) {
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      strip.querySelectorAll<HTMLElement>('.it2 .n').forEach(el => {
        const textNode = Array.from(el.childNodes).find(n => n.nodeType === 3) as Text | undefined;
        if (!textNode) return;
        const target = parseInt(textNode.nodeValue ?? '0', 10);
        const from = target > 100 ? target - 12 : 0;
        animateCount(textNode, from, target);
      });
    }, { threshold: 0.4 });
    observer.observe(strip);
  }
</script>

</Layout>

<script is:inline>
  (function () {
    var cards = document.querySelectorAll('.offer-card');
    if (!cards.length) return;
    var reduce = false;
    try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
    if (reduce) {
      cards.forEach(function (c) { c.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    cards.forEach(function (card) { io.observe(card); });
  })();
</script>

<style>
  /* HERO BUTTONS — premium overrides */
  .hero-cta .btn {
    padding: 14px 30px;
    font-size: 15px;
    letter-spacing: .01em;
    border-radius: 100px;
  }

  .hero-cta .btn-primary {
    background: linear-gradient(135deg, #488d94 0%, #5cb8bf 100%);
    color: #06121a;
    box-shadow:
      0 4px 22px rgba(72,141,148,.3),
      inset 0 1px 0 rgba(255,255,255,.12);
    transition: transform .25s ease, box-shadow .25s ease, color .25s ease;
  }
  .hero-cta .btn-primary::before {
    background: linear-gradient(135deg, #5cb8bf 0%, #7dd4da 100%);
  }
  .hero-cta .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow:
      0 10px 36px rgba(72,141,148,.5),
      0 0 0 2px rgba(124,192,198,.28),
      inset 0 1px 0 rgba(255,255,255,.12);
  }

  .hero-cta .btn-ghost {
    border: 1px solid rgba(72,141,148,.38);
    background: rgba(72,141,148,.04);
    color: var(--ink);
    transition: transform .25s ease, box-shadow .25s ease, color .25s ease, border-color .25s ease;
  }
  .hero-cta .btn-ghost::before { background: var(--accent); }
  .hero-cta .btn-ghost:hover {
    border-color: var(--accent);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(72,141,148,.22);
  }

  /* HERO */
  .hero {
    position: relative;
    padding: 96px 0 88px;
    margin-top: -1px;
    background-image: url('https://images.unsplash.com/photo-1576842546422-60562b9242ae?auto=format&fit=crop&w=1600&q=80');
    background-size: cover;
    background-position: center 55%;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(14,24,39,0.95) 40%, rgba(14,24,39,0.6) 100%);
    z-index: 0;
  }
  .hero .wrap { position: relative; z-index: 1; }
  .hero-top { display: grid; grid-template-columns: 1.5fr 1fr; gap: 60px; align-items: end; }
  .hero h1 { font-size: 78px; font-weight: 700; line-height: 1.02; letter-spacing: -.025em; }
  .hero-side { padding-bottom: 8px; }
  .hero-side p { font-size: 16px; color: var(--ink-2); line-height: 1.62; }
  .hero-cta { display: flex; flex-direction: column; gap: 11px; margin-top: 26px; }
  .hero-cta .btn { justify-content: center; }

  .hero-strip {
    display: flex; margin-top: 46px;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .it2 {
    flex: 1; padding: 26px 0; display: flex; flex-direction: column; align-items: center; gap: 6px;
    border-right: 1px solid var(--line-soft);
    text-align: center;
  }
  .it2:last-child { border-right: none; }
  .it2 .n { font-size: 32px; font-weight: 700; letter-spacing: -.025em; line-height: 1; }
  .it2 .n small { color: var(--accent-2); font-size: 20px; letter-spacing: 0; }
  .it2 .l { font-size: 12.5px; color: var(--ink-3); letter-spacing: .01em; }

  /* OFFER CARDS */
  .offers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .offer-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: 10px;
    padding: 40px 36px 36px;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    min-height: 300px;
  }
  .offer-card:hover {
    border-color: rgba(72,141,148,.5);
    border-top-color: var(--accent-2);
  }
  .offer-icon {
    font-size: 36px;
    line-height: 1;
    margin-bottom: 22px;
  }
  .offer-card h3 {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -.015em;
    margin-bottom: 14px;
  }
  .offer-card p {
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.65;
    flex: 1;
  }
  .offer-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 28px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-2);
    transition: gap .25s ease;
  }
  .offer-card:hover .offer-link { gap: 10px; }
  .offer-link .arr { transition: transform .25s ease; display: inline-block; }
  .offer-card:hover .offer-link .arr { transform: translateX(3px); }

  /* CTA */
  .cta-band { padding: 118px 0; }
  .cta-box { background: linear-gradient(140deg, var(--bg-3), var(--bg-2)); border: 1px solid var(--line); border-radius: 14px; padding: 80px 64px; text-align: center; position: relative; overflow: hidden; }
  .cta-box::before { content: ""; position: absolute; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle, rgba(72,141,148,.22), transparent 70%); top: -180px; right: -80px; pointer-events: none; }
  .cta-box::after { content: ""; position: absolute; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, rgba(72,141,148,.14), transparent 70%); bottom: -120px; left: -60px; pointer-events: none; }
  .cta-box h2 { font-size: 56px; font-weight: 700; line-height: 1.04; letter-spacing: -.025em; position: relative; }
  .cta-box p { font-size: 17px; color: var(--ink-2); margin: 22px auto 36px; max-width: 48ch; position: relative; }
  .cta-box .row { display: flex; gap: 13px; justify-content: center; position: relative; }

  /* INSTAGRAM */
  .ig-section { padding: 80px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ig-title { font-size: 32px; font-weight: 700; text-align: center; margin-bottom: 40px; letter-spacing: -.02em; }
  .ig-widget { max-width: 1000px; margin: 0 auto; }

  /* MOBILE */
  @media (max-width: 900px) {
    .hero-top { grid-template-columns: 1fr; }
    .hero h1 { font-size: 52px; }
    .hero { background-attachment: scroll; }
  }
  @media (max-width: 700px) {
    .offers-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hero h1 { font-size: 38px; }
    .hero-strip { flex-wrap: wrap; }
    .it2 { flex: 1 1 45%; }
    .offer-card { padding: 30px 24px 26px; }
    .cta-box { padding: 48px 24px; }
    .cta-box h2 { font-size: 36px; }
    .cta-box .row { flex-direction: column; align-items: center; }
  }
</style>
