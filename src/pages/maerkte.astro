---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const today = new Date();
today.setHours(0, 0, 0, 0);

const twoWeeksAgo = new Date(today);
twoWeeksAgo.setDate(today.getDate() - 14);

type MarktItem = {
  name: string; datum: string; uhrzeit: string;
  ort: string; adresse: string; dateObj: Date;
};

const alleMarkte = await getCollection('maerkte');

const processed: MarktItem[] = alleMarkte
  .map(m => ({ ...m.data, dateObj: new Date(m.data.datum) } as MarktItem))
  .filter(m => m.dateObj >= twoWeeksAgo)
  .sort((a, b) => a.dateObj.getTime() - b.dateObj.getTime());

const kommendeMarkte = processed.filter(m => m.dateObj >= today);
const vergangeneMarkte = processed.filter(m => m.dateObj < today);

function formatDay(d: Date): string  { return d.getDate().toString().padStart(2, '0'); }
function formatMonYear(d: Date): string {
  const mo = d.toLocaleDateString('de-DE', { month: 'long' });
  return `${mo} · ${d.getFullYear().toString().slice(2)}`;
}
function formatWeekday(d: Date): string {
  return d.toLocaleDateString('de-DE', { weekday: 'long' });
}
function mapsUrl(adresse: string): string {
  return `https://maps.google.com/?q=${encodeURIComponent(adresse)}`;
}
---

<Layout title="Märkte – Velaro Catering & Foodtruckservice" description="Velaro auf regionalen Märkten und Stadtfesten — kommende Termine und Standorte.">

  <!-- ═══════════ PAGE HERO ═══════════ -->
  <section class="ph">
    <div class="container ph-grid">
      <div class="reveal">
        <span class="eyebrow">Unsere Termine</span>
        <h1>Märkte &amp;<br/><span class="hand">Veranstaltungen</span></h1>
        <p class="ph-lead">
          Wir sind unterwegs — auf Stadtfesten, Bauernmärkten und Sommerfesten.
          Kommt vorbei, holt euch was Frisches, schaut uns über die Schulter.
          Wir freuen uns auf euch.
        </p>
        <a href="#termine" class="btn btn-primary">Termine ansehen <span class="arrow">↓</span></a>
      </div>
      <div class="ph-image reveal">
        <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?q=80&w=1400&auto=format&fit=crop" alt="Food Truck im Einsatz" />
        <span class="badge"><span class="dot"></span> Gerade unterwegs</span>
        <div class="ph-stats">
          <div><div class="k">{kommendeMarkte.length || alleMarkte.length}</div><div class="l">Termine</div></div>
          <div><div class="k">2</div><div class="l">Städte</div></div>
          <div><div class="k">10h</div><div class="l">Service/Tag</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ MARQUEE ═══════════ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>★ Stadtfest Heinsberg ★ Altstadtfest HDL ★ Bauernmarkt Erkelenz ★ Hochzeitsmarkt ★ Sommerfest ★</span>
      <span>★ Stadtfest Heinsberg ★ Altstadtfest HDL ★ Bauernmarkt Erkelenz ★ Hochzeitsmarkt ★ Sommerfest ★</span>
    </div>
  </div>

  <!-- ═══════════ OFFEN FÜR ALLE ═══════════ -->
  <section class="offen-section">
    <div class="container offen">
      <div class="offen-text reveal">
        <span class="eyebrow eyebrow--teal">Mehr als Essen</span>
        <h2>Offen für alle.<br/>Auch für <span class="hand">euch</span>.</h2>
        <p>
          Unsere Foodtrucks und Marktstände sind keine Restaurants im
          Kleinformat — sie sind Treffpunkte. Familien, Freunde, Kollegen,
          Hunde. Wer kommt, kommt.
        </p>
        <p>
          Von herzhaft bis vegetarisch, von Boulette bis Falafel — bei uns
          findet jeder was. Hauptsache, ihr habt Hunger.
        </p>
        <blockquote class="offen-quote">
          Wir kommen wegen des Essens — und bleiben wegen der Stimmung.
        </blockquote>
      </div>
      <div class="offen-media reveal">
        <img src="https://images.unsplash.com/photo-1636224601323-550e96f10d66?q=80&w=1200&auto=format&fit=crop" alt="Food Truck im Einsatz" />
        <div class="sticker-corner">Frisch<br/>vom<br/>Grill</div>
      </div>
    </div>
  </section>

  <!-- ═══════════ TIMELINE ═══════════ -->
  <section class="timeline-section" id="termine">
    <div class="container">
      <div class="timeline-head reveal">
        <div>
          <span class="eyebrow eyebrow--teal">Kommende Termine</span>
          <h2>Wo ihr uns als<br/><span class="hand">Nächstes</span> findet.</h2>
        </div>
        <a href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener" class="btn">
          Auf Instagram folgen <span class="arrow">→</span>
        </a>
      </div>

      <div class="timeline reveal-stagger">
        {kommendeMarkte.length > 0 ? (
          kommendeMarkte.map(markt => (
            <div class="tl-row">
              <div class="tl-date">
                <span class="tl-weekday">{formatWeekday(markt.dateObj)}</span>
                <span class="tl-day">{formatDay(markt.dateObj)}</span>
                <span class="tl-monyear">{formatMonYear(markt.dateObj)}</span>
              </div>
              <div class="tl-card">
                <div>
                  <div class="tl-cat-title">
                    <span class="tl-type-tag">Markt</span>
                  </div>
                  <h3>{markt.name}</h3>
                  <div class="tl-meta">
                    <span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      {markt.uhrzeit}
                    </span>
                    <span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                      {markt.ort}
                    </span>
                  </div>
                  <p class="tl-address">{markt.adresse}</p>
                </div>
                <a href={mapsUrl(markt.adresse)} target="_blank" rel="noopener noreferrer" class="tl-cta">
                  Auf Karte
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))
        ) : (
          <div class="empty-state">
            <div class="empty-icon">📅</div>
            <h3>Neue Termine folgen in Kürze</h3>
            <p>Folgt uns auf Instagram — dort kündigen wir neue Termine als Erstes an.</p>
            <a href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener" class="btn btn-primary">
              Instagram folgen <span class="arrow">→</span>
            </a>
          </div>
        )}

        {vergangeneMarkte.length > 0 && (
          <div class="vergangene">
            <p class="vergangene-label">Zuletzt dabei</p>
            {vergangeneMarkte.map(markt => (
              <div class="tl-row tl-row--past">
                <div class="tl-date">
                  <span class="tl-weekday">{formatWeekday(markt.dateObj)}</span>
                  <span class="tl-day">{formatDay(markt.dateObj)}</span>
                  <span class="tl-monyear">{formatMonYear(markt.dateObj)}</span>
                </div>
                <div class="tl-card">
                  <div>
                    <h3>{markt.name}</h3>
                    <div class="tl-meta">
                      <span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        {markt.uhrzeit}
                      </span>
                      <span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        {markt.ort}
                      </span>
                    </div>
                  </div>
                  <span class="past-badge">Vergangen</span>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ═══════════ MAP ═══════════ -->
  <section class="map-section">
    <div class="container">
      <div class="map-head reveal">
        <div>
          <span class="eyebrow">Einzugsgebiet</span>
          <h2>Unsere <span class="hand">Region</span>.</h2>
        </div>
        <p>Regelmäßig in Haldensleben, Heinsberg, Erkelenz und Umgebung. Anfragen aus anderen Städten sind jederzeit willkommen.</p>
      </div>

      <div class="map-card reveal">
        <div class="map-overlay"></div>
        <svg class="map-svg" viewBox="0 0 1000 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <path d="M 50 350 Q 200 200 380 280 T 700 200 Q 850 180 950 250" />
          <path d="M 100 100 Q 300 120 450 220 T 800 350" />
          <path d="M 0 250 Q 250 300 500 250 T 1000 300" stroke-opacity="0.5"/>
          <path d="M 300 0 Q 350 200 380 400" stroke-opacity="0.4"/>
          <path d="M 700 0 Q 680 250 720 500" stroke-opacity="0.4"/>
        </svg>

        <div class="map-pin" style="left: 38%; top: 40%;">
          <div class="map-pin-marker"></div>
          <div class="map-pin-tooltip">Haldensleben · Manufaktur</div>
        </div>
        <div class="map-pin" style="left: 58%; top: 55%;">
          <div class="map-pin-marker"></div>
          <div class="map-pin-tooltip">Heinsberg · Termine</div>
        </div>
        <div class="map-pin" style="left: 72%; top: 38%;">
          <div class="map-pin-marker"></div>
          <div class="map-pin-tooltip">Erkelenz · Bauernmarkt</div>
        </div>

        <div class="map-legend">
          <h4>Aktuelle Standorte</h4>
          <p>Über die Markierungen findet ihr unsere nächsten Termine.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ CTA ═══════════ -->
  <section class="section" style="background: var(--bg);">
    <div class="container">
      <div class="cta-card reveal">
        <div>
          <span class="eyebrow" style="background: var(--ink); color: var(--cream); box-shadow: 3px 3px 0 var(--hot);">Auf dem Laufenden</span>
          <h2 style="margin-top: 1rem;">Neue Termine, frische<br/><span class="hand">Gerichte</span>.</h2>
          <p>Standortwechsel und Sonderaktionen — zuerst auf Instagram. Schaut vorbei.</p>
        </div>
        <div class="btns">
          <a href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener" class="btn btn-cream">Instagram folgen <span class="arrow">→</span></a>
          <a href="/kontakt" class="btn btn-outline" style="color: var(--cream); border-color: var(--cream); box-shadow: 5px 5px 0 var(--ink);">Kontakt</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Page Hero ── */
  .ph {
    padding-top: clamp(8rem, 14vw, 11rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: var(--bg);
    color: var(--cream);
  }
  .ph-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .ph h1 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.9;
    margin: 1.25rem 0 1.5rem;
    color: var(--cream);
  }
  .ph h1 .hand { font-style: normal; color: var(--hot); font-size: 0.82em; }
  .ph-lead {
    font-size: 1.1rem;
    line-height: 1.55;
    max-width: 50ch;
    margin-bottom: 2rem;
    color: var(--text-2);
  }
  .ph-image {
    position: relative;
    aspect-ratio: 4/5;
    border: 4px solid var(--ink);
    overflow: hidden;
    transform: rotate(2deg);
    box-shadow: 10px 10px 0 var(--ink);
  }
  .ph-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(1.1) saturate(1.2);
  }
  .ph-image .badge {
    position: absolute;
    top: 1rem; left: 1rem;
    padding: 0.55rem 0.95rem;
    background: var(--hot);
    color: var(--cream);
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 3px solid var(--cream);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    transform: rotate(-3deg);
  }
  .ph-image .badge .dot {
    width: 10px; height: 10px;
    background: var(--cream);
    border-radius: 50%;
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.8); } }
  .ph-stats {
    position: absolute;
    bottom: -1.25rem;
    left: 1rem;
    right: 1rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    padding: 0;
    background: var(--ink);
    border: 4px solid var(--cream);
    box-shadow: 6px 6px 0 var(--hot);
  }
  .ph-stats > div { padding: 0.85rem 0.75rem; border-right: 2px solid rgba(243,235,220,0.18); }
  .ph-stats > div:last-child { border-right: none; }
  .ph-stats .k {
    font-family: var(--display);
    font-size: 2rem;
    color: var(--hot);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ph-stats .l {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    margin-top: 0.3rem;
  }
  @media (max-width: 900px) {
    .ph-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  /* ── Offen ── */
  .offen-section { padding-block: clamp(4rem, 9vw, 8rem); background: var(--bg); }
  .offen {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .offen-text h2 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    color: var(--cream);
  }
  .offen-text h2 .hand { color: var(--hot); }
  .offen-text p {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 50ch;
    color: var(--text-2);
  }
  .offen-quote {
    margin-top: 2rem;
    padding: 1.6rem 1.75rem;
    background: var(--hot);
    color: var(--cream);
    border: 3px solid rgba(243,235,220,0.25);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.35);
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.3;
    text-transform: none;
    letter-spacing: 0;
    transform: rotate(-1deg);
  }
  .offen-quote::before {
    content: '"';
    font-family: var(--serif);
    font-style: italic;
    font-size: 4rem;
    line-height: 0.5;
    display: block;
    color: rgba(243,235,220,0.55);
    margin-bottom: 0.5rem;
  }
  .offen-media {
    position: relative;
    aspect-ratio: 1;
    border: 4px solid var(--ink);
    overflow: hidden;
    transform: rotate(-1.5deg);
    box-shadow: 10px 10px 0 var(--hot);
  }
  .offen-media img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.08) saturate(1.15); }
  .offen-media .sticker-corner {
    position: absolute;
    top: -1rem; right: -1rem;
    width: 100px; height: 100px;
    background: var(--mustard);
    color: var(--ink);
    border: 4px solid var(--ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--display);
    font-size: 0.9rem;
    line-height: 0.95;
    text-transform: uppercase;
    transform: rotate(12deg);
    animation: wobbleSticker 4s ease-in-out infinite;
    box-shadow: 4px 4px 0 var(--ink);
  }
  @keyframes wobbleSticker {
    0%,100% { transform: rotate(12deg); }
    50%     { transform: rotate(-6deg) scale(1.05); }
  }
  @media (max-width: 900px) {
    .offen { grid-template-columns: 1fr; gap: 3rem; }
  }

  /* ── Timeline ── */
  .timeline-section {
    background: var(--navy);
    color: var(--cream);
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .timeline-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 3.5rem;
    flex-wrap: wrap;
  }
  .timeline-head h2 {
    color: var(--cream);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-top: 1rem;
  }
  .timeline-head h2 .hand { color: var(--hot); }

  .timeline {
    display: grid;
    gap: 1.5rem;
    max-width: 1080px;
    margin-inline: auto;
  }
  .tl-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  .tl-date {
    background: var(--hot);
    color: var(--cream);
    border: 4px solid var(--cream);
    padding: 1.25rem 0.85rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.2rem;
    box-shadow: 6px 6px 0 var(--cream);
    transform: rotate(-2deg);
    transition: transform var(--t-snap);
  }
  .tl-row:hover .tl-date { transform: rotate(2deg) scale(1.05); }
  .tl-row:nth-child(even) .tl-date { background: var(--accent); color: var(--navy-deep); transform: rotate(2deg); }
  .tl-row:nth-child(even):hover .tl-date { transform: rotate(-2deg) scale(1.05); }
  .tl-row:nth-child(3n) .tl-date { background: var(--mustard); color: var(--ink); }
  .tl-day {
    font-family: var(--display);
    font-size: 4rem;
    line-height: 0.85;
    letter-spacing: -0.02em;
  }
  .tl-monyear {
    font-family: var(--display);
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }
  .tl-weekday {
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .tl-card {
    background: var(--cream);
    color: var(--ink);
    border: 4px solid var(--cream);
    padding: 1.5rem 1.85rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.25rem;
    align-items: center;
    transition: transform var(--t-snap), box-shadow var(--t-snap);
  }
  .tl-row:hover .tl-card {
    transform: translate(-3px,-3px);
    box-shadow: 8px 8px 0 var(--hot);
  }
  .tl-cat-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.65rem;
  }
  .tl-type-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    background: var(--ink);
    color: var(--hot);
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .tl-card h3 {
    color: var(--ink);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 0.92;
    margin-bottom: 0.6rem;
  }
  .tl-card h3 .hand { color: var(--hot); font-size: 0.85em; }
  .tl-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }
  .tl-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tl-meta svg { color: var(--hot); }
  .tl-address {
    font-family: var(--sans);
    font-size: 0.82rem;
    color: var(--ink);
    opacity: 0.7;
    margin-top: 0.4rem;
  }
  .tl-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.9rem 1.3rem;
    background: var(--hot);
    color: var(--cream);
    border: 3px solid var(--ink);
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: all var(--t);
  }
  .tl-cta:hover {
    background: var(--ink);
    transform: translate(-2px,-2px);
    box-shadow: 4px 4px 0 var(--hot);
  }
  .tl-row--past .tl-card { opacity: 0.55; }
  .vergangene { margin-top: 3rem; }
  .vergangene-label {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-mute);
    margin-bottom: 1rem;
    opacity: 0.7;
  }
  .past-badge {
    flex-shrink: 0;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    background: rgba(243,235,220,0.1);
    color: var(--text-mute);
    border: 2px solid rgba(243,235,220,0.2);
    padding: 0.3rem 0.9rem;
    white-space: nowrap;
  }
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
    background: rgba(243,235,220,0.05);
    border: 3px dashed rgba(243,235,220,0.2);
    gap: 1rem;
    max-width: 480px;
    margin-inline: auto;
