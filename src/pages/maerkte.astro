---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const today = new Date();
today.setHours(0, 0, 0, 0);

const twoWeeksAgo = new Date(today);
twoWeeksAgo.setDate(today.getDate() - 14);

type MarktItem = {
  name: string; datum: string; uhrzeit: string;
  ort: string; adresse: string; dateObj: Date;
};

const alleMarkte = await getCollection('maerkte');

const processed: MarktItem[] = alleMarkte
  .map(m => ({ ...m.data, dateObj: new Date(m.data.datum) } as MarktItem))
  .filter(m => m.dateObj >= twoWeeksAgo)
  .sort((a, b) => a.dateObj.getTime() - b.dateObj.getTime());

const kommendeMarkte = processed.filter(m => m.dateObj >= today);
const vergangeneMarkte = processed.filter(m => m.dateObj < today);

function formatWeekday(d: Date): string {
  return d.toLocaleDateString('de-DE', { weekday: 'long' });
}

function formatDay(d: Date): string {
  return d.toLocaleDateString('de-DE', { day: '2-digit' });
}

function formatMonth(d: Date): string {
  return d.toLocaleDateString('de-DE', { month: 'short' });
}

function mapsUrl(adresse: string): string {
  return `https://maps.google.com/?q=${encodeURIComponent(adresse)}`;
}
---

<Layout title="Märkte – Velaro Catering & Foodtruckservice">

  <!-- HERO -->
  <section class="page-hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <div class="label-row reveal"><span class="ix">Unsere Termine</span><span class="ln"></span></div>
        <h1 class="stagger">Märkte &amp; <span class="it">Veranstaltungen.</span></h1>
        <p class="hero-sub reveal" data-d="2">Findet uns auf regionalen Märkten und Veranstaltungen in der Region. Frisch zubereitet, direkt zu euch.</p>
      </div>
      <div class="hero-img-wrap reveal" data-d="1">
        <img
          src="https://images.unsplash.com/photo-1638132704849-9370475ed2de?auto=format&fit=crop&w=900&q=80"
          alt="Velaro Foodtruck auf dem Markt"
          class="hero-img"
        />
        <div class="hero-img-glow"></div>
      </div>
    </div>
  </section>

  <!-- KOMMENDE MÄRKTE -->
  <section class="block">
    <div class="wrap">
      <div class="label-row reveal"><span class="ix">01</span><span class="tt">Kommende Märkte</span><span class="ln"></span></div>

      {kommendeMarkte.length > 0 ? (
        <div class="mk-list">
          {kommendeMarkte.map((markt, i) => (
            <a class="mk-row lift reveal" data-d={String(i % 4)} href={mapsUrl(markt.adresse)} target="_blank" rel="noopener noreferrer">
              <div class="cal">
                <div class="cal-day">{formatDay(markt.dateObj)}</div>
                <div class="cal-mon">{formatMonth(markt.dateObj)}</div>
              </div>
              <div class="mk-body">
                <div class="mk-wd">{formatWeekday(markt.dateObj)}</div>
                <h3>{markt.name}</h3>
                <div class="mk-meta">
                  <span class="mchip">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {markt.uhrzeit}
                  </span>
                  <span class="mchip">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    {markt.ort}
                  </span>
                </div>
                <p class="mk-adr">{markt.adresse}</p>
              </div>
              <div class="mk-go">
                <span>Auf Karte öffnen</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty reveal">
          <div class="e-ic">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3>Neue Termine folgen in Kürze</h3>
          <p>Folgt uns auf Instagram — dort kündigen wir neue Termine als Erstes an.</p>
          <a href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener" class="btn btn-primary" style="margin-top:8px;"><span>Instagram folgen</span> <span class="arr">→</span></a>
        </div>
      )}
    </div>
  </section>

  <!-- VERGANGENE MÄRKTE -->
  {vergangeneMarkte.length > 0 && (
    <section class="block past-sec">
      <div class="wrap">
        <div class="label-row reveal"><span class="ix">02</span><span class="tt">Zuletzt dabei</span><span class="ln"></span></div>
        <div class="mk-list past-list">
          {vergangeneMarkte.map((markt, i) => (
            <div class="mk-row mk-past reveal" data-d={String(i % 4)}>
              <div class="cal">
                <div class="cal-day">{formatDay(markt.dateObj)}</div>
                <div class="cal-mon">{formatMonth(markt.dateObj)}</div>
              </div>
              <div class="mk-body">
                <div class="mk-wd">{formatWeekday(markt.dateObj)}</div>
                <h3>{markt.name}</h3>
                <div class="mk-meta">
                  <span class="mchip">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {markt.uhrzeit}
                  </span>
                  <span class="mchip">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    {markt.ort}
                  </span>
                </div>
              </div>
              <span class="past-badge">Vergangen</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="cta-band">
    <div class="wrap">
      <div class="cta-box reveal">
        <h2>Immer auf dem <span class="it">Laufenden</span> bleiben.</h2>
        <p>Neue Termine, frische Gerichte und Aktionen — zuerst auf Instagram.</p>
        <div class="row">
          <a href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener" class="btn btn-primary"><span>Instagram folgen</span> <span class="arr">→</span></a>
          <a href="/kontakt" class="btn btn-ghost"><span>Kontakt aufnehmen</span></a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* HERO */
  .page-hero { padding: 80px 0 88px; border-bottom: 1px solid var(--line); }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero-text { display: flex; flex-direction: column; }
  .page-hero h1 { font-size: 62px; font-weight: 700; line-height: 1.03; letter-spacing: -.025em; margin-top: 16px; }
  .hero-sub { font-size: 17px; color: var(--ink-2); line-height: 1.65; max-width: 44ch; margin-top: 24px; }

  .hero-img-wrap {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 4/3;
    box-shadow: 0 24px 64px rgba(0,0,0,0.45);
  }
  .hero-img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
    transition: transform 6s ease;
  }
  .hero-img-wrap:hover .hero-img { transform: scale(1.04); }
  .hero-img-glow {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(72,141,148,0.12) 0%, transparent 60%);
    pointer-events: none;
  }

  /* MK LIST */
  .mk-list { display: flex; flex-direction: column; gap: 12px; }

  .mk-row {
    display: grid; grid-template-columns: 88px 1fr auto; gap: 32px; align-items: center;
    background: var(--bg-2); border: 1px solid var(--line); border-radius: 8px;
    padding: 24px 28px; cursor: pointer; text-decoration: none; color: inherit;
  }

  /* Calendar block */
  .cal { text-align: center; border-right: 1px solid var(--line); padding-right: 24px; }
  .cal-day { font-size: 36px; font-weight: 700; line-height: 1; letter-spacing: -.02em; }
  .cal-mon { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-3); margin-top: 6px; }

  /* Body */
  .mk-wd { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-2); font-weight: 600; margin-bottom: 6px; }
  .mk-body h3 { font-size: 22px; font-weight: 700; letter-spacing: -.01em; }
  .mk-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .mchip {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 12.5px; color: var(--ink-2);
    background: rgba(241,236,226,.05); border: 1px solid var(--line);
    border-radius: 100px; padding: 5px 12px;
  }
  .mk-adr { font-size: 12.5px; color: var(--ink-3); margin-top: 6px; }

  /* Go arrow */
  .mk-go { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--ink-3); white-space: nowrap; transition: color .25s; }
  .mk-row:hover .mk-go { color: var(--accent-2); }
  .mk-row:hover .mk-go svg { transform: translateX(3px); }
  .mk-go svg { transition: transform .25s; }

  /* Past */
  .past-sec { padding-top: 0; }
  .mk-past { opacity: 0.45; cursor: default; }
  .mk-past:hover { transform: none !important; border-color: var(--line) !important; box-shadow: none !important; }
  .past-badge { font-size: 11.5px; font-weight: 600; color: var(--ink-3); background: rgba(241,236,226,.05); border: 1px solid var(--line); border-radius: 100px; padding: 5px 12px; white-space: nowrap; }

  /* Empty state */
  .empty {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: 64px 24px;
    background: var(--bg-2); border: 1px dashed var(--line); border-radius: 8px; gap: 14px;
  }
  .e-ic { width: 52px; height: 52px; border-radius: 12px; background: rgba(72,141,148,.1); border: 1px solid rgba(72,141,148,.25); display: grid; place-items: center; color: var(--accent-2); }
  .empty h3 { font-size: 22px; font-weight: 700; }
  .empty p { font-size: 15px; color: var(--ink-2); max-width: 38ch; line-height: 1.6; }

  /* CTA */
  .cta-band { padding: 118px 0; }
  .cta-box { background: linear-gradient(140deg, var(--bg-3), var(--bg-2)); border: 1px solid var(--line); border-radius: 14px; padding: 72px 56px; text-align: center; position: relative; overflow: hidden; }
  .cta-box::before { content: ""; position: absolute; width: 360px; height: 360px; border-radius: 50%; background: radial-gradient(circle, rgba(72,141,148,.2), transparent 70%); top: -160px; right: -60px; pointer-events: none; }
  .cta-box h2 { font-size: 48px; font-weight: 700; line-height: 1.04; letter-spacing: -.025em; position: relative; }
  .cta-box p { font-size: 17px; color: var(--ink-2); margin: 18px auto 32px; max-width: 44ch; position: relative; }
  .cta-box .row { display: flex; gap: 13px; justify-content: center; position: relative; }

  /* MOBILE */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 36px; }
    .hero-img-wrap { aspect-ratio: 16/7; }
    .page-hero h1 { font-size: 48px; }
    .mk-row { grid-template-columns: 72px 1fr; }
    .mk-go { display: none; }
  }
  @media (max-width: 600px) {
    .page-hero h1 { font-size: 36px; }
    .mk-row { grid-template-columns: 1fr; gap: 16px; }
    .cal { border-right: none; border-bottom: 1px solid var(--line); padding-right: 0; padding-bottom: 16px; display: flex; gap: 12px; align-items: baseline; text-align: left; }
    .cal-day { font-size: 28px; }
    .cta-box { padding: 48px 24px; }
    .cta-box h2 { font-size: 32px; }
    .cta-box .row { flex-direction: column; align-items: center; }
  }
</style>
