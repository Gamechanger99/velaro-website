---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt – Velaro Catering & Foodtruckservice"
  description="Fragen oder eine Anfrage? Schreib uns — wir melden uns innerhalb von 24 Stunden mit einem persönlichen Angebot."
>

  <!-- HERO -->
  <section class="page-hero">
    <div class="wrap">
      <div class="label-row reveal"><span class="ix">Schreib uns</span><span class="ln"></span></div>
      <h1 class="stagger">Erzählt uns von <span class="it">eurem</span> Anlass.</h1>
      <p class="hero-sub reveal" data-d="2">Fragen, Wünsche oder einfach Hallo sagen — wir melden uns innerhalb von 24 Stunden zurück.</p>
    </div>
  </section>

  <!-- KONTAKT GRID -->
  <section class="kontakt-sec">
    <div class="wrap">
      <div class="k-grid">

        <!-- LINKE SPALTE: Formular -->
        <div class="form-col anim-up">
          <div class="form-card">
            <h2>Nachricht senden</h2>
            <p class="form-sub">Alle Felder mit * sind Pflichtfelder.</p>

            <form
              name="kontakt"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="contact-form"
              id="contactForm"
            >
              <input type="hidden" name="form-name" value="kontakt" />
              <p class="hidden"><label>Nicht ausfüllen: <input name="bot-field" /></label></p>

              <div class="form-row">
                <div class="form-group">
                  <label for="name">Name *</label>
                  <input type="text" id="name" name="name" placeholder="Max Mustermann" required autocomplete="name" />
                </div>
                <div class="form-group">
                  <label for="email">E-Mail *</label>
                  <input type="email" id="email" name="email" placeholder="max@beispiel.de" required autocomplete="email" />
                </div>
              </div>

              <div class="form-group">
                <label for="telefon">Telefon <span class="opt">optional</span></label>
                <input type="tel" id="telefon" name="telefon" placeholder="+49 160 00000000" autocomplete="tel" />
              </div>

              <div class="form-group">
                <label for="nachricht">Ihr Anliegen *</label>
                <textarea id="nachricht" name="nachricht" rows="6" placeholder="Was liegt euch auf dem Herzen? Erzählt uns von eurem Event, euren Wünschen oder stellt einfach eine Frage…" required></textarea>
              </div>

              <button type="submit" class="btn btn-primary sub-btn"><span>Nachricht absenden</span> <span class="arr">→</span></button>

              <p class="privacy">Mit dem Absenden stimmt ihr unserer <a href="/datenschutz">Datenschutzerklärung</a> zu.</p>
            </form>

            <div class="success-msg" id="successMsg">
              <div class="s-ic">✓</div>
              <h3>Danke für eure Nachricht!</h3>
              <p>Wir haben eure Anfrage erhalten und melden uns innerhalb von 24 Stunden zurück.</p>
            </div>
          </div>
        </div>

        <!-- RECHTE SPALTE: Infos -->
        <div class="info-col anim-up delay-1">

          <div class="resp-hint reveal" data-d="1">
            <span class="pulse-dot"></span>
            <p>Wir antworten in der Regel <strong>innerhalb von 24 Stunden</strong> — montags bis freitags.</p>
          </div>

          <div class="cc-list">
            <a href="mailto:kontakt@velaro-catering.de" class="cc lift reveal" data-d="2">
              <div class="cc-ic">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div class="cc-txt">
                <span class="cc-lbl">E-Mail</span>
                <span class="cc-val">kontakt@velaro-catering.de</span>
              </div>
              <svg class="cc-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>

            <a href="tel:+4916094839906" class="cc lift reveal" data-d="3">
              <div class="cc-ic">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.06 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16z"/></svg>
              </div>
              <div class="cc-txt">
                <span class="cc-lbl">Telefon</span>
                <span class="cc-val">0160 94839906</span>
              </div>
              <svg class="cc-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>

            <a href="https://instagram.com/velaro_cateringundfoodtruck" target="_blank" rel="noopener" class="cc lift reveal" data-d="4">
              <div class="cc-ic">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
              </div>
              <div class="cc-txt">
                <span class="cc-lbl">Instagram</span>
                <span class="cc-val">@velaro_cateringundfoodtruck</span>
              </div>
              <svg class="cc-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>

          <div class="avail-card reveal" data-d="5">
            <h4>Erreichbarkeit</h4>
            <ul class="hours">
              <li><span class="dy">Mo – Fr</span><span class="dl"></span><span class="tm">08:00 – 18:00 Uhr</span></li>
              <li><span class="dy">Samstag</span><span class="dl"></span><span class="tm">09:00 – 14:00 Uhr</span></li>
              <li><span class="dy">Sonntag</span><span class="dl"></span><span class="tm closed">Geschlossen</span></li>
            </ul>
          </div>

        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* HERO */
  .page-hero {
    position: relative;
    padding: 120px 0 100px;
    margin-top: -1px;
    border-bottom: none;
    background-image: url('https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=1600&q=80');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    overflow: hidden;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(14,24,39,0.95) 40%, rgba(14,24,39,0.6) 100%);
    z-index: 0;
  }
  .page-hero .wrap { position: relative; z-index: 1; }

  /* Hero entrance animations */
  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .page-hero .label-row {
    animation: heroFadeUp 0.55s ease both;
  }
  .page-hero h1 {
    animation: heroFadeUp 0.65s 0.1s ease both;
  }
  .page-hero .hero-sub {
    animation: heroFadeUp 0.65s 0.22s ease both;
  }

  .page-hero h1 { font-size: 64px; font-weight: 700; line-height: 1.04; letter-spacing: -.025em; margin-top: 16px; max-width: 14ch; }
  .hero-sub { font-size: 17px; color: var(--ink-2); line-height: 1.65; max-width: 52ch; margin-top: 22px; }

  /* KONTAKT GRID */
  .kontakt-sec { padding: 80px 0 120px; }
  .k-grid { display: grid; grid-template-columns: 1fr 380px; gap: 52px; align-items: start; }

  /* FORM CARD */
  .form-card { background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; padding: 40px; }
  .form-card h2 { font-size: 26px; font-weight: 700; letter-spacing: -.01em; }
  .form-sub { font-size: 13.5px; color: var(--ink-3); margin-top: 6px; margin-bottom: 32px; }
  .hidden { display: none; }

  .contact-form { display: flex; flex-direction: column; gap: 22px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-group label { font-size: 13px; font-weight: 600; color: var(--ink); display: flex; align-items: center; gap: 8px; }
  .opt { font-size: 10.5px; font-weight: 500; background: rgba(72,141,148,.14); color: var(--accent-2); border: 1px solid rgba(72,141,148,.3); border-radius: 100px; padding: 2px 8px; }

  .form-group input,
  .form-group textarea {
    background: var(--bg); border: 1px solid var(--line); border-radius: 8px;
    color: var(--ink); font-family: var(--sans); font-size: 14.5px;
    padding: 12px 16px; width: 100%; outline: none;
    transition: border-color .2s, box-shadow .2s;
  }
  .form-group input::placeholder,
  .form-group textarea::placeholder { color: var(--ink-3); }
  .form-group input:focus,
  .form-group textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(72,141,148,.14); }
  .form-group textarea { resize: vertical; min-height: 136px; line-height: 1.6; border-radius: 10px; }

  .sub-btn { align-self: flex-start; }
  .privacy { font-size: 12px; color: var(--ink-3); line-height: 1.5; }
  .privacy a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }

  /* SUCCESS */
  .success-msg {
    display: none; flex-direction: column; align-items: center; text-align: center;
    padding: 52px 24px; gap: 14px;
  }
  .success-msg.visible { display: flex; }
  .s-ic { width: 54px; height: 54px; border-radius: 50%; background: rgba(72,141,148,.14); border: 1px solid rgba(72,141,148,.38); display: grid; place-items: center; font-size: 22px; color: var(--accent-2); }
  .success-msg h3 { font-size: 22px; font-weight: 700; }
  .success-msg p { font-size: 15px; color: var(--ink-2); max-width: 34ch; line-height: 1.6; }

  /* INFO COL */
  .info-col { display: flex; flex-direction: column; gap: 16px; }

  .resp-hint { display: flex; align-items: flex-start; gap: 12px; background: rgba(72,141,148,.07); border: 1px solid rgba(72,141,148,.22); border-radius: 8px; padding: 16px 18px; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; margin-top: 4px; animation: glow 2s infinite; }
  @keyframes glow { 0%,100% { box-shadow: 0 0 5px rgba(72,141,148,.5); } 50% { box-shadow: 0 0 14px rgba(72,141,148,.9); } }
  .resp-hint p { font-size: 13.5px; color: var(--ink-2); line-height: 1.6; }
  .resp-hint strong { color: var(--ink); }

  .cc-list { display: flex; flex-direction: column; gap: 10px; }
  .cc {
    display: flex; align-items: center; gap: 14px;
    background: var(--bg-2); border: 1px solid var(--line); border-radius: 8px;
    padding: 14px 18px; cursor: pointer; text-decoration: none; color: inherit;
    transition: border-color .25s, transform .25s, box-shadow .25s;
  }
  .cc:hover { border-color: var(--accent); transform: translateX(4px); box-shadow: 0 4px 16px rgba(72,141,148,.1); }
  .cc-ic { width: 38px; height: 38px; flex-shrink: 0; border-radius: 8px; background: rgba(72,141,148,.1); border: 1px solid rgba(72,141,148,.24); display: grid; place-items: center; color: var(--accent); }
  .cc-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .cc-lbl { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--accent-2); }
  .cc-val { font-size: 13.5px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cc-arr { color: var(--ink-3); flex-shrink: 0; transition: transform .25s, color .25s; }
  .cc:hover .cc-arr { color: var(--accent-2); transform: translateX(3px); }

  .avail-card { background: var(--bg-2); border: 1px solid var(--line); border-radius: 8px; padding: 22px 22px; }
  .avail-card h4 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .16em; color: var(--ink-3); margin-bottom: 18px; }
  .hours { list-style: none; display: flex; flex-direction: column; gap: 13px; }
  .hours li { display: flex; align-items: center; gap: 10px; }
  .dy { font-size: 13.5px; font-weight: 500; min-width: 78px; }
  .dl { flex: 1; border-bottom: 1px dashed var(--line); opacity: .6; }
  .tm { font-size: 13.5px; color: var(--ink-2); }
  .closed { color: var(--ink-3); font-style: italic; }

  /* Scroll reveal */
  .anim-up {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .anim-up.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  .anim-up.delay-1 { transition-delay: 0.1s; }
  .anim-up.delay-2 { transition-delay: 0.2s; }

  /* MOBILE */
  @media (max-width: 900px) {
    .k-grid { grid-template-columns: 1fr; }
    .info-col { order: -1; }
    .page-hero h1 { font-size: 44px; }
    .page-hero { background-attachment: scroll; }
  }
  @media (max-width: 600px) {
    .page-hero h1 { font-size: 32px; }
    .form-card { padding: 24px; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in-view'); observer.unobserve(e.target); } }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.anim-up').forEach(el => observer.observe(el));

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const successMsg = document.getElementById('successMsg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);

    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData as any).toString(),
      });

      if (res.ok) {
        form.style.display = 'none';
        successMsg?.classList.add('visible');
        successMsg?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        alert('Es gab ein Problem beim Senden. Bitte versuche es nochmal.');
      }
    } catch {
      alert('Verbindungsfehler. Bitte prüfe deine Internetverbindung.');
    }
  });
</script>
