---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Impressum – Velaro Catering & Foodtruckservice"
  description="Impressum und Anbieterkennzeichnung gemäß § 5 TMG."
>

  <section class="page-hero">
    <div class="wrap">
      <div class="label-row reveal"><span class="ix">Rechtliches</span><span class="ln"></span></div>
      <h1 class="stagger">Impressum</h1>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="legal-content">

        <h2>Angaben gemäß § 5 TMG</h2>
        <p>
          Willi Vollack<br />
          Freischützstraße 10d<br />
          39340 Haldensleben
        </p>

        <h2>Kontakt</h2>
        <p>
          Telefon: 016094839906<br />
          E-Mail: <a href="mailto:kontakt@velaro-catering.de">kontakt@velaro-catering.de</a>
        </p>

        <h2>Redaktionell verantwortlich</h2>
        <p>
          Marc Simon Hackfurth<br />
          Arno-Nitzsche-Straße 44<br />
          04277 Leipzig
        </p>

        <h2>Quelle</h2>
        <p>eRecht24</p>

      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    position: relative;
    padding: 120px 0 100px;
    margin-top: -1px;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 50%, rgba(72,141,148,.07) 0%, transparent 70%);
    z-index: 0;
  }
  .page-hero .wrap { position: relative; z-index: 1; }
  .page-hero h1 { font-size: 56px; font-weight: 700; line-height: 1.04; letter-spacing: -.025em; margin-top: 16px; }

  @media (max-width: 767px) {
    .page-hero { padding: 80px 0 64px; }
    .page-hero h1 { font-size: 36px; }
  }
</style>
