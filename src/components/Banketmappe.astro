---
// Banketmappe.astro – Interaktiver Catering-Konfigurator
// Vanilla JS, keine externen Abhängigkeiten
---



<section class="bm-section" id="banketmappe">

  <!-- Netlify erkennt dieses Formular beim Build -->
  <form name="banketmappe" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input name="kategorie" />
    <input name="datum" />
    <input name="personen" />
    <input name="ort" />
    <input name="menu_auswahl" />
    <input name="getraenke" />
    <input name="wuensche" />
    <input name="kontakt_name" />
    <input name="kontakt_email" />
    <input name="kontakt_telefon" />
  </form>

  <div class="container">

    <div class="bm-intro">
      <h2>Interaktive <span class="text-accent">Banketmappe</span></h2>
      <p>Stellen Sie Ihr Wunsch-Catering zusammen und senden Sie uns Ihre Anfrage direkt zu.</p>
    </div>

    <!-- WIZARD -->
    <div class="bm-card" id="bmCard">

      <div class="bm-card-header">
        <div class="bm-progress-bar" id="bmProgressBar"></div>
        <div class="bm-header-text">
          <span class="bm-step-label" id="bmStepLabel">Interaktive Banketmappe</span>
          <div class="bm-step-title" id="bmStepTitle">Willkommen</div>
        </div>
      </div>


<div class="bm-body" id="bmBody"></div>

      <div class="bm-nav">
        <button class="bm-btn-back btn-outline" id="bmBack">← Zurück</button>
        <button class="bm-btn-next btn-primary" id="bmNext">Jetzt konfigurieren</button>
      </div>

    </div>

    <!-- ERFOLG -->
    <div class="bm-success" id="bmSuccess">
      <div class="bm-success-check">✓</div>
      <h3>Anfrage erfolgreich gesendet!</h3>
      <p>Wir melden uns so bald wie möglich bei Ihnen.</p>
      <button class="btn-primary" id="bmReset">Neue Anfrage starten</button>
    </div>

  </div>
</section>

<style is:global>

  .bm-section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .bm-intro {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }
  .bm-intro h2 { font-size: clamp(2.2rem, 4.5vw, 3.4rem); margin-top: 1rem; }
  .bm-intro p { margin-top: 1rem; font-size: 1rem; line-height: 1.7; color: var(--text-2); }

  /* ── Karte ── */
  .bm-card {
    max-width: 900px;
    margin-inline: auto;
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  /* ── Header ── */
  .bm-card-header {
    padding: 1.75rem 2.25rem 1.5rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .bm-progress-bar { display: flex; gap: 4px; margin-bottom: 1.1rem; }

  .bm-seg {
    width: 28px; height: 3px; border-radius: 2px;
    background: var(--border);
    transition: all 0.4s var(--ease);
  }
  .bm-seg.done   { background: var(--accent-deep); }
  .bm-seg.active { background: var(--accent); width: 44px; }

  .bm-header-text { display: flex; flex-direction: column; gap: 0.25rem; }

  .bm-step-label {
    font-family: var(--sans);
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--text-mute);
  }

  .bm-step-title {
    font-family: var(--serif);
    font-size: 1.6rem; line-height: 1.1; color: var(--text);
  }

  /* ── Body ── */
  .bm-body { padding: 2rem 2.25rem; min-height: 280px; }

  .bm-step-desc {
    font-size: 0.95rem; line-height: 1.65;
    color: var(--text-2); margin-bottom: 1.5rem;
  }

  /* ── Nav ── */
  .bm-nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.25rem 2.25rem; border-top: 1px solid var(--border-soft); gap: 1rem;
  }
  .bm-btn-back, .bm-btn-next {
    font-family: var(--sans);
    font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.85rem 1.4rem; border-radius: 999px;
    transition: all var(--t); border: 1px solid transparent; cursor: pointer;
  }
  .bm-btn-back {
    background: transparent; color: var(--text-mute);
    border-color: var(--border); visibility: hidden;
  }
  .bm-btn-back.bm-visible { visibility: visible; }
  .bm-btn-back:hover { color: var(--text); border-color: rgba(255,255,255,0.3); }
  .bm-btn-next {
    background: var(--accent); color: var(--bg-deep); border-color: transparent;
  }
  .bm-btn-next:hover {
    background: var(--cream); transform: translateY(-2px);
    box-shadow: 0 10px 24px -8px var(--accent-glow);
  }

  /* ══ STEP 0: Willkommen ══ */
  .bm-welcome {
    text-align: center; padding: 1.5rem 1rem;
  }
  .bm-welcome-headline {
    font-family: var(--serif);
    font-size: 1.8rem; margin-bottom: 1rem; color: var(--text);
  }
  .bm-welcome p {
    max-width: 460px; margin: 0 auto 2.5rem;
    font-size: 0.95rem; line-height: 1.7; color: var(--text-2);
  }
  .bm-feature-row {
    display: flex; gap: 3rem; justify-content: center; flex-wrap: wrap;
  }
  .bm-feature-item { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
  .bm-feature-bubble {
    width: 56px; height: 56px; border-radius: 50%;
    background: rgba(90,195,207,0.08);
    border: 1px solid rgba(90,195,207,0.3);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--serif); font-size: 1.5rem; color: var(--accent);
  }
  .bm-feature-label {
    font-size: 0.72rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--text-mute);
  }

  /* ══ STEP 1: Kategorie ══ */
  .bm-cat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }

  .bm-cat-card {
    position: relative;
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 1.25rem;
    cursor: pointer;
    transition: all var(--t);
    display: flex; flex-direction: column; gap: 0.3rem;
    user-select: none;
  }
  .bm-cat-card:hover {
    border-color: var(--accent);
    background: rgba(90,195,207,0.05);
    transform: translateY(-2px);
  }
  .bm-cat-card.bm-selected {
    border-color: var(--accent);
    background: rgba(90,195,207,0.08);
    box-shadow: 0 0 0 1px var(--accent), 0 8px 24px -6px var(--accent-glow);
  }
  .bm-cat-card.bm-selected::after {
    content: '✓';
    position: absolute; top: 0.85rem; right: 0.95rem;
    width: 22px; height: 22px;
    background: var(--accent); color: var(--bg-deep); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem; font-weight: 700;
  }
  .bm-cat-tag {
    display: inline-block; font-size: 0.62rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .bm-cat-name {
    font-family: var(--serif);
    font-size: 1.25rem; line-height: 1.1; color: var(--text); margin-bottom: 0.35rem;
  }
  .bm-cat-desc { font-size: 0.82rem; color: var(--text-mute); line-height: 1.5; }

  /* ══ STEP 2: Eckdaten ══ */
  .bm-form { display: flex; flex-direction: column; gap: 1.1rem; }
  .bm-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }

  .bm-field { display: flex; flex-direction: column; gap: 0.4rem; }
  .bm-field label {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--text-mute);
  }
  .bm-field input,
  .bm-field textarea {
    background: var(--bg-deep) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--r-sm) !important;
    color: var(--text) !important;
    font: 400 0.9rem var(--sans) !important;
    padding: 0.75rem 0.9rem !important;
    width: 100% !important;
    outline: none !important;
    transition: border-color var(--t), box-shadow var(--t) !important;
    -webkit-appearance: none; appearance: none;
    box-sizing: border-box !important;
  }
  .bm-field input::placeholder,
  .bm-field textarea::placeholder {
    color: rgba(166,166,166,0.35) !important;
  }
  .bm-field input:focus,
  .bm-field textarea:focus {
    border-color: var(--accent) !important;
    box-shadow: 0 0 0 3px var(--accent-glow) !important;
  }
  .bm-field input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(0.7); cursor: pointer;
  }

  .bm-field-divider { border: none; border-top: 1px solid var(--border-soft); margin: 0.5rem 0; }
  .bm-field-group-label {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent);
  }

  /* ══ STEP 3: Menü ══ */
  .bm-menu-status {
    display: flex; justify-content: space-between; align-items: center;
    background: var(--bg-deep); border: 1px solid var(--border);
    border-radius: var(--r-sm); padding: 0.75rem 1.1rem;
    margin-bottom: 1.5rem; font-size: 0.85rem;
  }
  .bm-menu-status span { color: var(--text-mute); }
  .bm-menu-status strong { color: var(--text); }

  .bm-dish-group { margin-bottom: 1.75rem; }
  .bm-dish-group-title {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--accent);
    margin-bottom: 0.75rem; padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .bm-dish-list { display: flex; flex-direction: column; gap: 0.4rem; }
  .bm-dish-wrap { display: flex; flex-direction: column; gap: 0.4rem; }

  .bm-dish {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.7rem 1rem;
    background: var(--bg-deep); border: 1px solid var(--border);
    border-radius: var(--r-sm); cursor: pointer;
    font-size: 0.88rem; color: var(--text-2);
    transition: all var(--t); user-select: none;
  }
  .bm-dish:hover { border-color: var(--accent); color: var(--text); }
  .bm-dish.bm-active {
    border-color: var(--accent); background: rgba(90,195,207,0.08); color: var(--text);
  }

  .bm-dish-dot {
    width: 18px; height: 18px; border-radius: 50%;
    border: 1.5px solid var(--border); flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    transition: all var(--t);
  }
  .bm-dish.bm-active .bm-dish-dot { border-color: var(--accent); background: var(--accent); }
  .bm-dish-dot-inner {
    width: 7px; height: 7px; border-radius: 50%;
    background: transparent; transition: background var(--t);
  }
  .bm-dish.bm-active .bm-dish-dot-inner { background: var(--bg-deep); }
  .bm-dish-label { flex: 1; }

  .bm-sub-chips {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    padding: 0.25rem 0.25rem 0.25rem 2.4rem;
  }
  .bm-sub-chip {
    font-size: 0.75rem; padding: 0.35rem 0.75rem;
    background: var(--bg-deep); border: 1px solid var(--border);
    border-radius: 999px; color: var(--text-mute); cursor: pointer;
    transition: all var(--t); user-select: none;
  }
  .bm-sub-chip:hover { border-color: var(--accent); color: var(--text); }
  .bm-sub-chip.bm-active {
    border-color: var(--accent); background: rgba(90,195,207,0.15);
    color: var(--accent); font-weight: 600;
  }

  /* ── Item-Badge ── */
  .bm-item-badge {
    font-size: 0.6rem; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 0.2rem 0.55rem;
    border-radius: 999px; white-space: nowrap; flex-shrink: 0;
  }
  .bm-badge-incl, .bm-badge-base { background: rgba(90,195,207,0.15); color: var(--accent); }
  .bm-badge-extra { background: rgba(166,166,166,0.1); color: var(--text-mute); }

  /* ── Food-Truck Info-Box ── */
  .bm-info-box {
    display: flex; align-items: flex-start; gap: 0.7rem;
    padding: 0.9rem 1.1rem; margin-bottom: 1.5rem;
    background: rgba(90,195,207,0.05);
    border: 1px solid rgba(90,195,207,0.2); border-radius: var(--r-sm);
    font-size: 0.85rem; line-height: 1.6; color: var(--text-2);
  }
  .bm-info-icon { color: var(--accent); flex-shrink: 0; margin-top: 0.1rem; }

  /* ── Empfehlungsbox ── */
  .bm-reco-box {
    margin-top: 1.25rem; padding: 1rem 1.25rem;
    background: rgba(90,195,207,0.05);
    border-left: 2px solid var(--accent); border-radius: var(--r-sm);
  }
  .bm-reco-label {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent);
    display: block; margin-bottom: 0.6rem;
  }
  .bm-reco-rows {
    display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem;
    font-size: 0.85rem; color: var(--text-2);
  }
  .bm-reco-rows strong { color: var(--text); }

  /* ══ STEP 4: Wünsche ══ */
  .bm-wishes-wrap { display: flex; flex-direction: column; gap: 0.5rem; }
  .bm-wishes-wrap textarea {
    width: 100% !important; min-height: 150px !important;
    background: var(--bg-deep) !important; border: 1px solid var(--border) !important;
    border-radius: var(--r-sm) !important; color: var(--text) !important;
    font: 400 0.9rem var(--sans) !important; padding: 0.85rem 1rem !important;
    resize: vertical !important; outline: none !important; line-height: 1.6 !important;
    transition: border-color var(--t), box-shadow var(--t) !important;
    box-sizing: border-box !important;
  }
  .bm-wishes-wrap textarea::placeholder { color: rgba(166,166,166,0.35) !important; }
  .bm-wishes-wrap textarea:focus {
    border-color: var(--accent) !important; box-shadow: 0 0 0 3px var(--accent-glow) !important;
  }
  .bm-hint { font-size: 0.78rem; color: var(--text-mute); margin-top: 0.6rem; line-height: 1.5; }

  /* ══ STEP 5: Zusammenfassung ══ */
  .bm-summary-block { margin-bottom: 1.5rem; }
  .bm-summary-title {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 0.75rem;
  }
  .bm-summary-row {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 0.55rem 0; border-bottom: 1px solid var(--border-soft);
    font-size: 0.9rem; gap: 1rem;
  }
  .bm-row-key { color: var(--text-mute); flex-shrink: 0; }
  .bm-row-val { color: var(--text); text-align: right; }

  /* ══ Erfolg ══ */
  .bm-success {
    display: none; flex-direction: column; align-items: center;
    text-align: center; gap: 1.25rem; padding: 4rem 2rem;
    max-width: 900px; margin-inline: auto;
    background: var(--bg-card); border: 1px solid var(--border-soft); border-radius: var(--r-lg);
  }
  .bm-success.bm-visible { display: flex; }
  .bm-success-check {
    width: 64px; height: 64px;
    background: rgba(90,195,207,0.12); border: 1px solid rgba(90,195,207,0.4);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; color: var(--accent);
  }
  .bm-success h3 { font-size: 2rem; color: var(--text); }
  .bm-success p { max-width: 380px; font-size: 0.95rem; line-height: 1.7; color: var(--text-2); }
  .bm-success button {
    font-family: var(--sans); font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.9rem 1.6rem; border-radius: 999px;
    background: var(--accent); color: var(--bg-deep); border: none;
    transition: all var(--t); cursor: pointer;
  }
  .bm-success button:hover { background: var(--cream); transform: translateY(-2px); }

  /* ── Getränke-Step ── */
  .bm-drink-cards { display: flex; flex-direction: column; gap: 0.875rem; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .bm-card-header { padding: 1.25rem; flex-wrap: wrap; }
    .bm-body { padding: 1.5rem 1.25rem; }
    .bm-nav { padding: 1rem 1.25rem; flex-direction: column-reverse; }
    .bm-btn-back, .bm-btn-next { width: 100%; text-align: center; justify-content: center; }
    .bm-cat-grid, .bm-drink-grid, .bm-dish-grid { grid-template-columns: 1fr; }
    .bm-form-row { grid-template-columns: 1fr; }
  }
</style>

<script>
// @ts-nocheck

const CATS = [
  { id:'buffet', tag:'Buffet',     name:'Klassisches Buffet',  desc:'Warme & kalte Speisen für jeden Anlass' },
  { id:'grill',  tag:'Grill',      name:'Grillbuffet',          desc:'Frisch vom Grill – deftig & gesellig' },
  { id:'snacks', tag:'Fingerfood', name:'Kleine Speisen',        desc:'Wraps, Canapés & Fingerfood – ab 10 Personen' },
  { id:'truck',  tag:'Food Truck', name:'Food Truck Catering',   desc:'Saftige Burger direkt zu Ihrem Event' },
];

const DRINKS = [
  { id:'none', name:'Keine Getränkepauschale',    desc:'Getränke selbst organisieren' },
  { id:'soft', name:'Getränke-Pauschale',          desc:'Inkl. Bier & Weinauswahl' },
  { id:'full', name:'Getränke-Pauschale Premium',  desc:'Großes Getränke-Sortiment' },
];

// Sub-Optionen: { label, subs: string[] | null }
// subs:null = keine Sub-Auswahl nötig
const SHARED_SUPPEN = [
  { label:'Altmärker Hochzeitssuppe', subs:null },
  { label:'Tomatencremesuppe', subs:null },
  { label:'Pilzcremesuppe', subs:null },
];
const SHARED_HAUPTGAENGE = [
  { label:'Deftiges vom Blech (Schnitzel, Schweinefilet & Hähnchenbrust)', subs:['mit Pilzrahmsauce','mit Zwiebel-Bratensauce','mit klassischer Bratensauce','mit Pfeffersauce','dazu mediterranes Grillgemüse'] },
  { label:'Hähnchenbrust', subs:['A – klassisch gewürzt','B – gefüllt mit Feta und Spinat','C – Caprese Style'] },
  { label:'Hähnchenbrust – Zubereitung', subs:['auf Bandnudeln in feiner Kräuter-Rahmsauce mit Estragon','mit mediterranem Grillgemüse','mit Pfeffersauce'] },
  { label:'Schweinefilet', subs:['mit mediterranem Grillgemüse','mit Pfeffersauce','in Pfefferrahm'] },
  { label:'Lachsfilet', subs:['auf Sesam-Spargel-Pfanne','auf jungem Blattspinat','in Zitronen-Dill-Sauce','Pasta al Salmone / Seelachsfilet'] },
];
const SHARED_VEGETARISCH = [
  { label:'Gnocchipfanne', subs:null },
  { label:'Falafel', subs:['auf geröstetem Paprikagemüse','Tomatenreis','Rote Beete-Feta-Stampf'] },
  { label:'Gefüllte Zucchini', subs:['auf geröstetem Paprikagemüse','Tomatenreis','Rote Beete-Feta-Stampf'] },
];
const SHARED_BEILAGEN = [
  { label:'Frische Salatauswahl',  subs:null, default:true, badge:'Inklusive' },
  { label:'Baguette und Brot',     subs:null, default:true, badge:'Inklusive' },
  { label:'Butterplatte',          subs:null, default:true, badge:'Inklusive' },
  { label:'Dipvariation',          subs:null, default:true, badge:'Inklusive' },
  { label:'Kartoffelgratin',       subs:null },
  { label:'Salzkartoffeln',        subs:null },
  { label:'Petersilienkartoffeln', subs:null },
  { label:'Reis',                  subs:null },
  { label:'Spätzle',               subs:null },
  { label:'Nudeln',                subs:null },
  { label:'Risotto',               subs:null },
  { label:'Pilzrisotto',           subs:null },
  { label:'Cheddarrisotto',        subs:null },
  { label:'Kartoffelbrei',         subs:null },
];
const SHARED_DESSERT = [
  { label:'Obstsalat', subs:null },
  { label:'Schokomousse mit Kirschgrütze', subs:null },
  { label:'Crème Brûlée', subs:null },
  { label:'Schichtgläser', subs:null },
  { label:'Cremespeise mit Fruchtspiegel', subs:null },
  { label:'Kuchenvariation', subs:null },
];

const MENU = {
  buffet: {
    sections:[
      { title:'Suppen', items: SHARED_SUPPEN },
      { title:'Hauptgänge', items: SHARED_HAUPTGAENGE },
      { title:'Vegetarisch', items: SHARED_VEGETARISCH },
      { title:'Beilagen', items: SHARED_BEILAGEN },
      { title:'Dessert', items: SHARED_DESSERT },
    ],
  },
  grill: {
    sections:[
      { title:'Vom Grill', items:[
        { label:'Bratwurst', subs:null },
        { label:'Boulette', subs:null },
        { label:'Grillgemüse', subs:null },
        { label:'Tomaten-Feta-Pfännchen', subs:null },
        { label:'Fackeln', subs:null },
        { label:'Steak', subs:['Schwein','Hühnchen'] },
      ]},
      { title:'Suppen', items: SHARED_SUPPEN },
      { title:'Hauptgänge', items: SHARED_HAUPTGAENGE },
      { title:'Vegetarisch', items: SHARED_VEGETARISCH },
      { title:'Beilagen', items: SHARED_BEILAGEN },
      { title:'Dessert', items: SHARED_DESSERT },
    ],
  },
  snacks: {
    sections:[
      { title:'Auswahl', items:[
        { label:'Obst', subs:null },
        { label:'Fingerfood', subs:null },
        { label:'Belegte Brötchen', subs:null },
        { label:'Obstsalat', subs:null },
        { label:'Suppe', subs:null },
        { label:'Crostinis', subs:null },
        { label:'Bruschetta', subs:null },
      ]},
    ],
  },
  truck: {
    infoBox: 'Die folgenden 5 Burger sowie Pommes Frites und Loaded Fries sind im Grundsortiment enthalten. Weitere Burger und Beilagen können gegen Aufpreis (nach Absprache) hinzugefügt werden.',
    sections:[
      { title:'Burger', items:[
        { label:'Cheeseburger',        subs:null, default:true, badge:'Grundsortiment' },
        { label:'Hamburger',           subs:null, default:true, badge:'Grundsortiment' },
        { label:'Chili-Cheese Burger', subs:null, default:true, badge:'Grundsortiment' },
        { label:'Onion Overload',      subs:null, default:true, badge:'Grundsortiment' },
        { label:'Veggie Burger',       subs:null, default:true, badge:'Grundsortiment' },
        { label:'Pulled Pork Burger',                      subs:null, badge:'Aufpreis auf Anfrage' },
        { label:'Teriyaki Burger',                         subs:null, badge:'Aufpreis auf Anfrage' },
        { label:'BBQ Burger',                              subs:null, badge:'Aufpreis auf Anfrage' },
        { label:'Apfel-Camembert Burger',                  subs:null, badge:'Aufpreis auf Anfrage' },
        { label:'Pulled Teriyaki Lachs Burger',            subs:null, badge:'Aufpreis auf Anfrage' },
        { label:'Leberkäse Burger',                        subs:null, badge:'Aufpreis auf Anfrage' },
        { label:'Rösti Burger',                            subs:null, badge:'Aufpreis auf Anfrage' },
        { label:'Burger Mexiko-Style',                     subs:null, badge:'Aufpreis auf Anfrage' },
        { label:'Ziegenkäse-Rucola-Feigenmarmeladen Burger', subs:null, badge:'Aufpreis auf Anfrage' },
      ]},
      { title:'Beilagen', items:[
        { label:'Pommes Frites',      subs:null, default:true, badge:'Grundsortiment' },
        { label:'Loaded Fries',       subs:null, default:true, badge:'Grundsortiment' },
        { label:'Onion Rings',        subs:null, badge:'Aufpreis auf Anfrage' }, // TODO: Kunde ergänzt
        { label:'Coleslaw',           subs:null, badge:'Aufpreis auf Anfrage' }, // TODO: Kunde ergänzt
        { label:'Sweet Potato Fries', subs:null, badge:'Aufpreis auf Anfrage' }, // TODO: Kunde ergänzt
        { label:'Mac & Cheese Bites', subs:null, badge:'Aufpreis auf Anfrage' }, // TODO: Kunde ergänzt
      ]},
    ],
  },
};

const TOTAL_STEPS = 6;
const TITLES = ['Willkommen','Kategorie','Eckdaten','Menü zusammenstellen','Getränkepauschale','Individuelle Wünsche','Zusammenfassung'];

const S = { step:0, category:'', persons:30, date:'', location:'', name:'', email:'', phone:'', menuSel:{}, drink:'none', wishes:'' };

function initDefaults(catId) {
  S.menuSel = {};
  const menu = MENU[catId];
  if (!menu) return;
  menu.sections.forEach(sec => {
    const defs = sec.items.filter(it => it.default);
    if (defs.length) S.menuSel[sec.title] = defs.map(it => ({ item:it.label, subOptions:[] }));
  });
}

function getRecommendation(persons) {
  if (!persons || persons <= 0) return null;
  if (persons < 30) return { fleisch:'1 Fleischgericht',  fisch:'1 Fischgericht', beilagen:'1–2 Beilagen', gemuese:'1 Gemüsebeilage' };
  if (persons < 50) return { fleisch:'2 Fleischgerichte', fisch:'1 Fischgericht', beilagen:'2–3 Beilagen', gemuese:'1 Gemüsebeilage' };
  return                   { fleisch:'3 Fleischgerichte', fisch:'2 Fischgerichte', beilagen:'3 Beilagen',   gemuese:'1 Gemüsebeilage' };
}

function htmlRecommendation(persons) {
  const r = getRecommendation(persons);
  if (!r) return '';
  return `<div class="bm-reco-box">
    <span class="bm-reco-label">ℹ Empfehlung für ${persons} Personen</span>
    <div class="bm-reco-rows">
      <span><strong>${r.fleisch}</strong></span>
      <span><strong>${r.fisch}</strong></span>
      <span><strong>${r.beilagen}</strong></span>
      <span><strong>${r.gemuese}</strong></span>
    </div>
  </div>`;
}

function refreshProgress() {
  const bar = document.getElementById('bmProgressBar');
  if (!bar) return;
  if (S.step===0) { bar.innerHTML=''; return; }
  bar.innerHTML = Array.from({length:TOTAL_STEPS},(_,i)=>{
    const n=i+1;
    return `<div class="bm-seg${n<S.step?' done':n===S.step?' active':''}"></div>`;
  }).join('');
}

function render() {
  document.getElementById('bmStepTitle').textContent = S.step===0 ? 'Willkommen' : TITLES[S.step];
  document.getElementById('bmStepLabel').textContent = S.step===0 ? 'Interaktive Banketmappe' : `Schritt ${S.step} von ${TOTAL_STEPS}`;
  const back = document.getElementById('bmBack');
  const next = document.getElementById('bmNext');
  S.step===0 ? back.classList.remove('bm-visible') : back.classList.add('bm-visible');
  next.textContent = S.step===0 ? 'Jetzt konfigurieren →' : S.step===TOTAL_STEPS ? '✉ Anfrage absenden' : 'Weiter →';
  refreshProgress();
  const body = document.getElementById('bmBody');
  switch(S.step) {
    case 0: body.innerHTML = htmlWelcome(); break;
    case 1: body.innerHTML = htmlCategory(); bindCat(); break;
    case 2: body.innerHTML = htmlDetails(); bindDetails(); break;
    case 3: body.innerHTML = htmlMenu(); bindMenu(); break;
    case 4: body.innerHTML = htmlDrinks(); bindDrinks(); break;
    case 5: body.innerHTML = htmlWishes(); bindWishes(); break;
    case 6: body.innerHTML = htmlSummary(); break;
  }
}

function htmlWelcome() {
  return `<div class="bm-welcome">
    <div class="bm-welcome-headline">Ihr Catering, Ihre Wahl.</div>
    <p>Kategorien wählen, Gerichte zusammenstellen und direkt anfragen — in wenigen Schritten zu Ihrem individuellen Angebot.</p>
    <div class="bm-feature-row">
      <div class="bm-feature-item"><div class="bm-feature-bubble">4</div><span class="bm-feature-label">Kategorien</span></div>
      <div class="bm-feature-item"><div class="bm-feature-bubble">6</div><span class="bm-feature-label">Schritte</span></div>
      <div class="bm-feature-item"><div class="bm-feature-bubble">✉</div><span class="bm-feature-label">Direkt anfragen</span></div>
    </div>
  </div>`;
}

function htmlCategory() {
  return `<p class="bm-step-desc">Welche Art von Catering möchten Sie buchen?</p>
  <div class="bm-cat-grid">${CATS.map(c=>`
    <div class="bm-cat-card${S.category===c.id?' bm-selected':''}" data-id="${c.id}">
      <span class="bm-cat-tag">${c.tag}</span>
      <div class="bm-cat-name">${c.name}</div>
      <div class="bm-cat-desc">${c.desc}</div>
    </div>`).join('')}</div>`;
}

function bindCat() {
  document.querySelectorAll('.bm-cat-card').forEach(el=>{
    el.addEventListener('click',()=>{
      const id=el.getAttribute('data-id');
      if(S.category!==id){ S.category=id; initDefaults(id); }
      document.querySelectorAll('.bm-cat-card').forEach(c=>c.classList.remove('bm-selected'));
      el.classList.add('bm-selected');
    });
  });
}

function htmlDetails() {
  return `<p class="bm-step-desc">Bitte geben Sie die Eckdaten Ihrer Veranstaltung an.</p>
  <div class="bm-form">
    <div class="bm-form-row">
      <div class="bm-field"><label>Personenanzahl *</label><input type="number" id="bfPersons" value="${S.persons}" min="1" max="1000" placeholder="z.B. 50"></div>
      <div class="bm-field"><label>Datum *</label><input type="date" id="bfDate" value="${S.date}"></div>
    </div>
    <div class="bm-field"><label>Veranstaltungsort *</label><input type="text" id="bfLocation" value="${S.location}" placeholder="Adresse oder Venue-Name"></div>
    <hr class="bm-field-divider">
    <p class="bm-field-group-label">Ihre Kontaktdaten</p>
    <div class="bm-form-row">
      <div class="bm-field"><label>Name *</label><input type="text" id="bfName" value="${S.name}" placeholder="Vor- und Nachname"></div>
      <div class="bm-field"><label>E-Mail *</label><input type="email" id="bfEmail" value="${S.email}" placeholder="ihre@email.de"></div>
    </div>
    <div class="bm-field"><label>Telefon (optional)</label><input type="tel" id="bfPhone" value="${S.phone}" placeholder="+49 ..."></div>
  </div>
  <div id="bmRecoWrap">${htmlRecommendation(S.persons)}</div>`;
}

function bindDetails() {
  document.getElementById('bfPersons')?.addEventListener('input', e => {
    S.persons = parseInt(e.target.value) || 1;
    const wrap = document.getElementById('bmRecoWrap');
    if (wrap) wrap.innerHTML = htmlRecommendation(S.persons);
  });
  const on=(id,key)=>document.getElementById(id)?.addEventListener('input',e=>{ S[key]=e.target.value; });
  on('bfDate','date'); on('bfLocation','location');
  on('bfName','name'); on('bfEmail','email'); on('bfPhone','phone');
}

function getSecSel(secTitle) {
  return S.menuSel[secTitle] || [];
}

function toggleItem(secTitle, itemLabel) {
  if (!S.menuSel[secTitle]) S.menuSel[secTitle] = [];
  const arr = S.menuSel[secTitle];
  const idx = arr.findIndex(x=>x.item===itemLabel);
  if (idx>=0) arr.splice(idx,1);
  else arr.push({ item:itemLabel, subOptions:[] });
}

function toggleSub(secTitle, itemLabel, sub) {
  if (!S.menuSel[secTitle]) return;
  const entry = S.menuSel[secTitle].find(x=>x.item===itemLabel);
  if (!entry) return;
  const idx = entry.subOptions.indexOf(sub);
  if (idx>=0) entry.subOptions.splice(idx,1);
  else entry.subOptions.push(sub);
}

function badgeClass(badge) {
  if (badge === 'Inklusive')      return 'bm-badge-incl';
  if (badge === 'Grundsortiment') return 'bm-badge-base';
  return 'bm-badge-extra';
}

function htmlMenu() {
  const menu = MENU[S.category]; if (!menu) return '';
  const totalSel = Object.values(S.menuSel).reduce((a,arr)=>a+arr.length,0);

  const infoBoxHtml = menu.infoBox
    ? `<div class="bm-info-box"><span class="bm-info-icon">ℹ</span><span>${menu.infoBox}</span></div>`
    : '';

  const sectionsHtml = menu.sections.map(sec=>{
    const secSel   = getSecSel(sec.title);
    const itemsHtml = sec.items.map(it=>{
      const active    = secSel.some(x=>x.item===it.label);
      const entry     = secSel.find(x=>x.item===it.label);
      const badgeHtml = it.badge
        ? `<span class="bm-item-badge ${badgeClass(it.badge)}">${it.badge}</span>`
        : '';
      let subHtml = '';
      if (active && it.subs) {
        subHtml = `<div class="bm-sub-chips" data-sec="${esc(sec.title)}" data-item="${esc(it.label)}">
          ${it.subs.map(s=>{
            const subActive = entry?.subOptions.includes(s);
            return `<span class="bm-sub-chip${subActive?' bm-active':''}" data-sub="${esc(s)}">${s}</span>`;
          }).join('')}
        </div>`;
      }
      return `<div class="bm-dish-wrap">
        <div class="bm-dish${active?' bm-active':''}" data-sec="${esc(sec.title)}" data-item="${esc(it.label)}">
          <div class="bm-dish-dot"><div class="bm-dish-dot-inner"></div></div>
          <span class="bm-dish-label">${it.label}</span>
          ${badgeHtml}
        </div>
        ${subHtml}
      </div>`;
    }).join('');
    return `<div class="bm-dish-group">
      <div class="bm-dish-group-title">${sec.title}</div>
      <div class="bm-dish-list">${itemsHtml}</div>
    </div>`;
  }).join('');

  return `<p class="bm-step-desc">Wählen Sie Ihre gewünschten Speisen aus.</p>
    ${infoBoxHtml}
    <div class="bm-menu-status"><span>Ausgewählt: <strong>${totalSel} Gericht${totalSel!==1?'e':''}</strong></span></div>
    ${sectionsHtml}`;
}

function esc(s) { return s.replace(/"/g,'&quot;'); }

function bindMenu() {
  document.querySelectorAll('.bm-dish').forEach(el=>{
    el.addEventListener('click',()=>{
      const sec=el.getAttribute('data-sec'), item=el.getAttribute('data-item');
      toggleItem(sec,item);
      document.getElementById('bmBody').innerHTML=htmlMenu(); bindMenu();
    });
  });
  document.querySelectorAll('.bm-sub-chip').forEach(el=>{
    el.addEventListener('click', e=>{
      e.stopPropagation();
      const wrap=el.closest('.bm-sub-chips');
      const sec=wrap.getAttribute('data-sec'), item=wrap.getAttribute('data-item');
      const sub=el.getAttribute('data-sub');
      toggleSub(sec,item,sub);
      document.getElementById('bmBody').innerHTML=htmlMenu(); bindMenu();
    });
  });
}

function htmlDrinks() {
  return `<p class="bm-step-desc">Möchten Sie eine Getränkepauschale dazubuchen?</p>
  <div class="bm-drink-cards">${DRINKS.map(d=>`
    <div class="bm-cat-card${S.drink===d.id?' bm-selected':''}" data-drink="${d.id}">
      <div class="bm-cat-name">${d.name}</div>
      <div class="bm-cat-desc">${d.desc}</div>
    </div>`).join('')}</div>`;
}

function bindDrinks() {
  document.querySelectorAll('.bm-drink-cards .bm-cat-card').forEach(el=>{
    el.addEventListener('click',()=>{
      S.drink = el.getAttribute('data-drink');
      document.querySelectorAll('.bm-drink-cards .bm-cat-card').forEach(c=>c.classList.remove('bm-selected'));
      el.classList.add('bm-selected');
    });
  });
}

function htmlWishes() {
  return `<p class="bm-step-desc">Haben Sie besondere Wünsche, Allergien oder sonstige Anmerkungen?</p>
  <div class="bm-wishes-wrap">
    <textarea id="bfWishes" placeholder="z.B. vegane Optionen, Nussallergien, besondere Dekoration...">${S.wishes}</textarea>
    <p class="bm-hint">Alle Angaben sind unverbindlich. Wir prüfen Ihre Wünsche und melden uns bei Bedarf für Details.</p>
  </div>`;
}

function bindWishes() {
  document.getElementById('bfWishes')?.addEventListener('input',e=>{S.wishes=e.target.value;});
}

function htmlSummary() {
  const cat  = CATS.find(c=>c.id===S.category);
  const menu = MENU[S.category];
  const row  = (k,v)=>`<div class="bm-summary-row"><span class="bm-row-key">${k}</span><span class="bm-row-val">${v}</span></div>`;

  const menuHtml = Object.entries(S.menuSel).filter(([,arr])=>arr.length>0).map(([sec,arr])=>{
    const secDef = menu?.sections.find(s=>s.title===sec);
    const lines  = arr.map(e=>{
      const itDef     = secDef?.items.find(i=>i.label===e.item);
      const badgePart = itDef?.badge ? ` <span style="color:#488d94;font-size:0.72rem">(${itDef.badge})</span>` : '';
      const subPart   = e.subOptions.length ? ` → ${e.subOptions.join(', ')}` : '';
      return `<div class="bm-summary-row"><span class="bm-row-key">—</span><span class="bm-row-val">${e.item}${subPart}${badgePart}</span></div>`;
    }).join('');
    return `<div class="bm-summary-block"><div class="bm-summary-title">${sec}</div>${lines}</div>`;
  }).join('');

  return `
    <div class="bm-summary-block"><div class="bm-summary-title">Veranstaltung</div>
      ${row('Catering-Art',cat.name)}${row('Datum',S.date||'–')}${row('Ort',S.location||'–')}${row('Personen',S.persons+' Personen')}
    </div>
    ${menuHtml || `<div class="bm-summary-block"><div class="bm-summary-title">Menü</div>${row('—','Keine Auswahl getroffen')}</div>`}
    <div class="bm-summary-block"><div class="bm-summary-title">Getränke</div>
      ${row('Getränkepauschale', DRINKS.find(d=>d.id===S.drink)?.name || '–')}
    </div>
    <div class="bm-summary-block"><div class="bm-summary-title">Kontakt</div>
      ${row('Name',S.name||'–')}${row('E-Mail',S.email||'–')}${S.phone?row('Telefon',S.phone):''}
    </div>
    ${S.wishes?`<div class="bm-summary-block"><div class="bm-summary-title">Individuelle Wünsche</div><div class="bm-summary-row"><span class="bm-row-val" style="text-align:left">${S.wishes}</span></div></div>`:''}`;
}

function validate() {
  if(S.step===1&&!S.category){alert('Bitte wählen Sie eine Catering-Art.');return false;}
  if(S.step===2){
    if(!S.persons||S.persons<1){alert('Bitte Personenanzahl angeben.');return false;}
    if(!S.date){alert('Bitte Datum angeben.');return false;}
    if(!S.location){alert('Bitte Veranstaltungsort angeben.');return false;}
    if(!S.name){alert('Bitte Namen angeben.');return false;}
    if(!S.email||!S.email.includes('@')){alert('Bitte gültige E-Mail angeben.');return false;}
  }
  if(S.step===3){
    const total=Object.values(S.menuSel).reduce((a,arr)=>a+arr.length,0);
    if(total<1){alert('Bitte mindestens ein Gericht auswählen.');return false;}
  }
  return true;
}

async function submit() {
  const cat  = CATS.find(c => c.id === S.category);
  const menu = MENU[S.category];

  const menuText = Object.entries(S.menuSel)
    .filter(([,arr])=>arr.length>0)
    .map(([sec,arr])=>{
      const secDef = menu?.sections.find(s=>s.title===sec);
      const lines  = arr.map(e=>{
        const itDef     = secDef?.items.find(i=>i.label===e.item);
        const badgePart = itDef?.badge ? ` (${itDef.badge})` : '';
        const subPart   = e.subOptions.length ? ` → ${e.subOptions.join(', ')}` : '';
        return `  — ${e.item}${subPart}${badgePart}`;
      }).join('\n');
      return `${sec}:\n${lines}`;
    }).join('\n') || '–';

  const payload = new URLSearchParams({
    'form-name':       'banketmappe',
    'kategorie':       cat.name,
    'datum':           S.date,
    'personen':        String(S.persons),
    'ort':             S.location,
    'menu_auswahl':    menuText,
    'getraenke':       DRINKS.find(d=>d.id===S.drink)?.name || '–',
    'wuensche':        S.wishes || 'Keine',
    'kontakt_name':    S.name,
    'kontakt_email':   S.email,
    'kontakt_telefon': S.phone || '–',
  });

  try {
    const res = await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: payload.toString(),
    });

    if (res.ok) {
      document.getElementById('bmCard').style.display = 'none';
      document.getElementById('bmSuccess').classList.add('bm-visible');
    } else {
      alert('Fehler beim Senden. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt: kontakt@velaro-catering.de');
    }
  } catch (err) {
    alert('Verbindungsfehler. Bitte prüfen Sie Ihre Internetverbindung.');
  }
}

document.getElementById('bmNext')?.addEventListener('click',()=>{
  if(S.step===TOTAL_STEPS){submit();return;}
  if(!validate())return;
  S.step++; render();
  document.getElementById('banketmappe')?.scrollIntoView({behavior:'smooth',block:'start'});
});

document.getElementById('bmBack')?.addEventListener('click',()=>{
  if(S.step>0){S.step--;render();document.getElementById('banketmappe')?.scrollIntoView({behavior:'smooth',block:'start'});}
});

document.getElementById('bmReset')?.addEventListener('click',()=>{
  Object.assign(S,{step:0,category:'',persons:30,date:'',location:'',name:'',email:'',phone:'',menuSel:{},drink:'none',wishes:''});
  document.getElementById('bmCard').style.display='';
  document.getElementById('bmSuccess').classList.remove('bm-visible');
  render();
});

render();
</script>