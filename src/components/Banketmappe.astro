  }
  .bm-cascade-select:focus { border-color: #488d94; }
  .bm-cascade-wrap {
    margin-top: 0.5rem; display: flex; flex-direction: column;
    gap: 0.4rem; padding: 0 0.25rem;
  }
  .bm-cascade-label { font-size: 0.78rem; color: #7a8fa6; margin-bottom: 0.1rem; font-family: "Montserrat", sans-serif; }

  /* ── Datenschutzhinweis ── */
  .bm-privacy-note {
    font-size: 0.8rem;
    color: #7a8fa6;
    margin-bottom: 1rem;
    line-height: 1.5;
    margin-top: 1.25rem;
  }
  .bm-privacy-note a {
    color: #488d94;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .bm-privacy-note a:hover {
    opacity: 0.8;
  }

  /* ── Patty-Auswahl ── */
  .bm-patty-wrap {
    margin-bottom: 1.5rem;
    padding: 1rem 1.25rem;
    background: rgba(72,141,148,0.06);
    border: 1px solid rgba(72,141,148,0.2);
    border-radius: 0.75rem;
  }
  .bm-patty-hint {
    font-size: 0.8rem; color: #7a8fa6;
    margin: 0.25rem 0 0.75rem;
    font-family: "Montserrat", sans-serif;
  }
  .bm-patty-options { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .bm-patty-btn {
    padding: 0.5rem 1.25rem; border-radius: 2rem;
    border: 1px solid #2a3f5a; background: transparent;
    color: #a6b8c8; font-size: 0.88rem; cursor: pointer;
    transition: all 0.2s; font-family: "Montserrat", sans-serif;
  }
  .bm-patty-btn:hover { border-color: #488d94; color: #e8e0d0; }
  .bm-patty-active { background: #488d94 !important; border-color: #488d94 !important; color: #fff !important; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .bm-body, .bm-card-header { padding: 1.25rem; }
    .bm-nav { padding: 0.9rem 1.25rem; }
    .bm-price-bar { padding: 0.7rem 1.25rem; }
    .bm-cat-grid, .bm-drink-grid, .bm-dish-grid { grid-template-columns: 1fr; }
    .bm-choice-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.875rem; }
    .bm-choice-card { flex-basis: auto; min-width: 0; }
    .bm-form-row { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ SHARED_VORSPEISEN, SHARED_SUPPEN, SHARED_HAUPTGAENGE, SHARED_VEGETARISCH, SHARED_BEILAGEN, SHARED_DESSERT, GRILL_ITEMS, SNACK_ITEMS, BURGER_ITEMS, BURGER_BEILAGEN_ITEMS, KINDER_ITEMS }}>
// @ts-nocheck

const CATS = [
  { id:'buffet', tag:'Buffet',     name:'Klassisches Buffet',  desc:'Warme & kalte Speisen für jeden Anlass' },
  { id:'grill',  tag:'Grill',      name:'Grillbuffet',          desc:'Frisch vom Grill – deftig & gesellig' },
  { id:'snacks', tag:'Fingerfood', name:'Kleine Speisen',        desc:'Wraps, Canapés & Fingerfood – ab 10 Personen' },
  { id:'truck',  tag:'Burger',     name:'Burger Catering',       desc:'Saftige Burger direkt zu Ihrem Event' },
];

const DRINKS = [
  { id:'none', name:'Keine Getränkepauschale',    desc:'Getränke selbst organisieren' },
  { id:'soft', name:'Getränke-Pauschale',          desc:'Inkl. Bier & Weinauswahl' },
  { id:'full', name:'Getränke-Pauschale Premium',  desc:'Großes Getränke-Sortiment' },
];

const GESCHIRR_OPTIONS = ['Besteck', 'Teller', 'Beides', 'Keine'];

const SAEUBERUNG_OPTIONS = [
  { id:'eigen', name:'Eigene Säuberung', hint:'10% Preisnachlass' },
  { id:'uns',   name:'Säuberung von uns' },
];

function saeuberungLabel(id) {
  const opt = SAEUBERUNG_OPTIONS.find(o=>o.id===id);
  if (!opt) return '';
  return opt.hint ? `${opt.name} (${opt.hint})` : opt.name;
}

const MENU = {
  buffet: {
    sections:[
      { title:'Vorspeisen', items: SHARED_VORSPEISEN },
      { title:'Suppen', items: SHARED_SUPPEN },
      { title:'Hauptgänge', items: SHARED_HAUPTGAENGE },
      { title:'Vegetarisch', items: SHARED_VEGETARISCH },
      { title:'Beilagen', items: SHARED_BEILAGEN },
      { title:'Dessert', items: SHARED_DESSERT },
      { title:'Für die Kleinen', items: KINDER_ITEMS },
    ],
  },
  grill: {
    sections:[
      { title:'Vorspeisen', items: SHARED_VORSPEISEN },
      { title:'Vom Grill', items: GRILL_ITEMS },
      { title:'Suppen', items: SHARED_SUPPEN },
      { title:'Hauptgänge', items: SHARED_HAUPTGAENGE },
      { title:'Vegetarisch', items: SHARED_VEGETARISCH },
      { title:'Beilagen', items: SHARED_BEILAGEN },
      { title:'Dessert', items: SHARED_DESSERT },
      { title:'Für die Kleinen', items: KINDER_ITEMS },
    ],
  },
  snacks: {
    sections:[
      { title:'Auswahl', items: SNACK_ITEMS },
    ],
  },
  truck: {
    infoBox: 'Die folgenden 5 Burger sowie Pommes Frites und Loaded Fries sind im Grundsortiment enthalten. Weitere Burger und Beilagen können gegen Aufpreis (nach Absprache) hinzugefügt werden.',
    sections:[
      { title:'Burger', items: BURGER_ITEMS },
      { title:'Beilagen', items: BURGER_BEILAGEN_ITEMS },
    ],
  },
};

const TOTAL_STEPS = 7;
const TITLES = ['Willkommen','Kategorie','Eckdaten','Menü zusammenstellen','Getränkepauschale','Geschirr & Säuberung','Individuelle Wünsche','Zusammenfassung'];

const S = { step:0, category:'', persons:30, date:'', location:'', name:'', email:'', phone:'', menuSel:{}, drink:'none', geschirr:'', saeuberung:'', wishes:'', patty:'' };

function findItemDef(secTitle, itemLabel) {
  const menu = MENU[S.category];
  if (!menu) return null;
  const sec = menu.sections.find(s => s.title === secTitle);
  if (!sec) return null;
  return sec.items.find(it => it.label === itemLabel) || null;
}

function initDefaults(catId) {
  S.menuSel = {};
  const menu = MENU[catId];
  if (!menu) return;
  menu.sections.forEach(sec => {
    const defs = sec.items.filter(it => it.default);
    if (defs.length) S.menuSel[sec.title] = defs.map(it => ({ item:it.label, subOptions:[] }));
  });
}

function getRecommendation(persons) {
  if (!persons || persons <= 0) return null;
  if (persons < 30) return { fleisch:'1 Fleischgericht',  fisch:'1 Fischgericht', beilagen:'1–2 Beilagen', gemuese:'1 Gemüsebeilage' };
  if (persons < 50) return { fleisch:'2 Fleischgerichte', fisch:'1 Fischgericht', beilagen:'2–3 Beilagen', gemuese:'1 Gemüsebeilage' };
  return                   { fleisch:'3 Fleischgerichte', fisch:'2 Fischgerichte', beilagen:'3 Beilagen',   gemuese:'1 Gemüsebeilage' };
}

function htmlRecommendation(persons) {
  if (S.category === 'snacks' || S.category === 'truck') return '';
  const r = getRecommendation(persons);
  if (!r) return '';
  return `<div class="bm-reco-box">
    <span class="bm-reco-label">ℹ Empfehlung für ${persons} Personen</span>
    <div class="bm-reco-rows">
      <span><strong>${r.fleisch}</strong></span>
      <span><strong>${r.fisch}</strong></span>
      <span><strong>${r.beilagen}</strong></span>
      <span><strong>${r.gemuese}</strong></span>
    </div>
  </div>`;
}

function refreshProgress() {
  const bar = document.getElementById('bmProgressBar');
  if (!bar) return;
  if (S.step===0) { bar.innerHTML=''; return; }
  bar.innerHTML = Array.from({length:TOTAL_STEPS},(_,i)=>{
    const n=i+1;
    return `<div class="bm-seg${n<S.step?' done':n===S.step?' active':''}"></div>`;
  }).join('');
}

function render() {
  document.getElementById('bmStepTitle').textContent = S.step===0 ? 'Willkommen' : TITLES[S.step];
  document.getElementById('bmStepLabel').textContent = S.step===0 ? 'Interaktive Banketmappe' : `Schritt ${S.step} von ${TOTAL_STEPS}`;
  const back = document.getElementById('bmBack');
  const next = document.getElementById('bmNext');
  S.step===0 ? back.classList.remove('bm-visible') : back.classList.add('bm-visible');
  next.textContent = S.step===0 ? 'Jetzt konfigurieren →' : S.step===TOTAL_STEPS ? '✉ Anfrage absenden' : 'Weiter →';
  refreshProgress();
  const body = document.getElementById('bmBody');
  switch(S.step) {
    case 0: body.innerHTML = htmlWelcome(); break;
    case 1: body.innerHTML = htmlCategory(); bindCat(); break;
    case 2: body.innerHTML = htmlDetails(); bindDetails(); break;
    case 3: body.innerHTML = htmlMenu(); bindMenu(); break;
    case 4: body.innerHTML = htmlDrinks(); bindDrinks(); break;
    case 5: body.innerHTML = htmlGeschirrSaeuberung(); bindGeschirrSaeuberung(); break;
    case 6: body.innerHTML = htmlWishes(); bindWishes(); break;
    case 7: body.innerHTML = htmlSummary(); break;
  }
}

function htmlWelcome() {
  return `<div class="bm-welcome">
    <div class="bm-welcome-headline">Ihr Catering, Ihre Wahl.</div>
    <p>Kategorien wählen, Gerichte zusammenstellen und direkt anfragen — in wenigen Schritten zu Ihrem individuellen Angebot.</p>
    <div class="bm-feature-row">
      <div class="bm-feature-item"><div class="bm-feature-bubble">4</div><span class="bm-feature-label">Kategorien</span></div>
      <div class="bm-feature-item"><div class="bm-feature-bubble">7</div><span class="bm-feature-label">Schritte</span></div>
      <div class="bm-feature-item"><div class="bm-feature-bubble">✉</div><span class="bm-feature-label">Direkt anfragen</span></div>
    </div>
  </div>`;
}

function htmlCategory() {
  return `<p class="bm-step-desc">Welche Art von Catering möchten Sie buchen?</p>
  <div class="bm-cat-grid">${CATS.map(c=>`
    <div class="bm-cat-card${S.category===c.id?' bm-selected':''}" data-id="${c.id}">
      <span class="bm-cat-tag">${c.tag}</span>
      <div class="bm-cat-name">${c.name}</div>
      <div class="bm-cat-desc">${c.desc}</div>
    </div>`).join('')}</div>`;
}

function bindCat() {
  document.querySelectorAll('.bm-cat-card').forEach(el=>{
    el.addEventListener('click',()=>{
      const id=el.getAttribute('data-id');
      if(S.category!==id){ S.category=id; initDefaults(id); }
      document.querySelectorAll('.bm-cat-card').forEach(c=>c.classList.remove('bm-selected'));
      el.classList.add('bm-selected');
    });
  });
}

function htmlDetails() {
  return `<p class="bm-step-desc">Bitte geben Sie die Eckdaten Ihrer Veranstaltung an.</p>
  <div class="bm-form">
    <div class="bm-form-row">
      <div class="bm-field"><label>Personenanzahl *</label><input type="number" id="bfPersons" value="${S.persons}" min="1" max="1000" placeholder="z.B. 50"></div>
      <div class="bm-field"><label>Datum *</label><input type="date" id="bfDate" value="${S.date}"></div>
    </div>
    <div class="bm-field"><label>Adresse *</label><input type="text" id="bfLocation" value="${S.location}" placeholder="Straße, Ort"></div>
    <hr class="bm-field-divider">
    <p class="bm-field-group-label">Ihre Kontaktdaten</p>
    <div class="bm-form-row">
      <div class="bm-field"><label>Name *</label><input type="text" id="bfName" value="${S.name}" placeholder="Vor- und Nachname"></div>
      <div class="bm-field"><label>E-Mail *</label><input type="email" id="bfEmail" value="${S.email}" placeholder="ihre@email.de"></div>
    </div>
    <div class="bm-field"><label>Telefon (optional)</label><input type="tel" id="bfPhone" value="${S.phone}" placeholder="+49 ..."></div>
  </div>
  <div id="bmRecoWrap">${htmlRecommendation(S.persons)}</div>`;
}

function bindDetails() {
  document.getElementById('bfPersons')?.addEventListener('input', e => {
    S.persons = parseInt(e.target.value) || 1;
    const wrap = document.getElementById('bmRecoWrap');
    if (wrap) wrap.innerHTML = htmlRecommendation(S.persons);
  });
  const on=(id,key)=>document.getElementById(id)?.addEventListener('input',e=>{ S[key]=e.target.value; });
  on('bfDate','date'); on('bfLocation','location');
  on('bfName','name'); on('bfEmail','email'); on('bfPhone','phone');
}

function getSecSel(secTitle) {
  return S.menuSel[secTitle] || [];
}

function toggleItem(secTitle, itemLabel) {
  if (!S.menuSel[secTitle]) S.menuSel[secTitle] = [];
  const arr = S.menuSel[secTitle];
  const idx = arr.findIndex(x=>x.item===itemLabel);
  if (idx>=0) arr.splice(idx,1);
  else {
    const entry = { item:itemLabel, subOptions:[] };
    const itDef = findItemDef(secTitle, itemLabel);
    if (itDef?.cascade) entry.cascadeChoices = {};
    arr.push(entry);
  }
}

function toggleSub(secTitle, itemLabel, sub) {
  if (!S.menuSel[secTitle]) return;
  const entry = S.menuSel[secTitle].find(x=>x.item===itemLabel);
  if (!entry) return;
  const idx = entry.subOptions.indexOf(sub);
  if (idx>=0) entry.subOptions.splice(idx,1);
  else entry.subOptions.push(sub);
}

function badgeClass(badge) {
  if (badge === 'Inklusive')      return 'bm-badge-incl';
  if (badge === 'Grundsortiment') return 'bm-badge-base';
  return 'bm-badge-extra';
}

function htmlCascade(it, entry, sec) {
  let html = '<div class="bm-cascade-wrap">';
  for (let i = 0; i < it.cascade.length; i++) {
    const step = it.cascade[i];
    if (i > 0 && !entry.cascadeChoices[it.cascade[i-1].question]) break;
    const currentVal = entry.cascadeChoices[step.question] || '';
    html += `<div>
      <div class="bm-cascade-label">${step.question}</div>
      <select class="bm-cascade-select" data-sec="${esc(sec.title)}" data-item="${esc(it.label)}" data-cascade-key="${esc(step.question)}">
        <option value="">Bitte wählen ...</option>
        ${step.options.map(o=>`<option value="${esc(o)}"${currentVal===o?' selected':''}>${o}</option>`).join('')}
      </select>
    </div>`;
  }
  html += '</div>';
  return html;
}

function htmlMenu() {
  const menu = MENU[S.category]; if (!menu) return '';
  const totalSel = Object.values(S.menuSel).reduce((a,arr)=>a+arr.length,0);

  const infoBoxHtml = menu.infoBox
    ? `<div class="bm-info-box"><span class="bm-info-icon">ℹ</span><span>${menu.infoBox}</span></div>`
    : '';

  const sectionsHtml = menu.sections.map(sec=>{
    const secSel   = getSecSel(sec.title);
    const itemsHtml = sec.items.map(it=>{
      const active    = secSel.some(x=>x.item===it.label);
      const entry     = secSel.find(x=>x.item===it.label);
      const badgeHtml = it.badge
        ? `<span class="bm-item-badge ${badgeClass(it.badge)}">${it.badge}</span>`
        : '';
      let subHtml = '';
      if (active && it.subs) {
        subHtml = `<div class="bm-sub-chips" data-sec="${esc(sec.title)}" data-item="${esc(it.label)}">
          ${it.subs.map(s=>{
            const subActive = entry?.subOptions.includes(s);
            return `<span class="bm-sub-chip${subActive?' bm-active':''}" data-sub="${esc(s)}">${s}</span>`;
          }).join('')}
        </div>`;
      } else if (active && it.cascade) {
        subHtml = htmlCascade(it, entry, sec);
      }
      return `<div class="bm-dish-wrap">
        <div class="bm-dish${active?' bm-active':''}" data-sec="${esc(sec.title)}" data-item="${esc(it.label)}">
          <div class="bm-dish-dot"><div class="bm-dish-dot-inner"></div></div>
          <span class="bm-dish-label">${it.label}</span>
          ${badgeHtml}
        </div>
        ${subHtml}
      </div>`;
    }).join('');
    const customEntries = secSel.map((e,i)=>({e,i})).filter(({e})=>e.isCustom);
    const customHtml = customEntries.map(({e,i})=>{
      const displayName = e.item.replace(/^__custom__/,'');
      return `<div class="bm-custom-item">
        <input type="text" class="bm-custom-input bm-custom-existing"
          data-sec="${esc(sec.title)}" data-custom-idx="${i}"
          value="${esc(displayName)}" placeholder="Eigener Wunsch ...">
        <button class="bm-custom-remove" data-sec="${esc(sec.title)}" data-custom-idx="${i}">✕</button>
      </div>`;
    }).join('');
    return `<div class="bm-dish-group">
      <div class="bm-dish-group-title">${sec.title}</div>
      <div class="bm-dish-list">${itemsHtml}</div>
      ${customHtml}
      <button class="bm-custom-add" data-sec="${esc(sec.title)}">+ Eigener Wunsch</button>
    </div>`;
  }).join('');

  let pattyHtml = '';
  if (S.category === 'truck') {
    pattyHtml = `
      <div class="bm-patty-wrap">
        <div class="bm-dish-group-title">Patty-Auswahl</div>
        <p class="bm-patty-hint">Gilt für alle ausgewählten Burger</p>
        <div class="bm-patty-options">
          ${['Beef', 'Crispy Chicken', 'Beides möglich'].map(opt => `
            <button class="bm-patty-btn${S.patty === opt ? ' bm-patty-active' : ''}"
              data-patty="${opt}">${opt}</button>
          `).join('')}
        </div>
      </div>
    `;
  }

  return `<p class="bm-step-desc">Wählen Sie Ihre gewünschten Speisen aus.</p>
    ${pattyHtml}
    ${infoBoxHtml}
    <div class="bm-menu-status"><span>Ausgewählt: <strong>${totalSel} Gericht${totalSel!==1?'e':''}</strong></span></div>
    ${sectionsHtml}`;
}

function esc(s) { return s.replace(/"/g,'&quot;'); }

function bindMenu() {
  document.querySelectorAll('.bm-dish').forEach(el=>{
    el.addEventListener('click',()=>{
      const sec=el.getAttribute('data-sec'), item=el.getAttribute('data-item');
      toggleItem(sec,item);
      document.getElementById('bmBody').innerHTML=htmlMenu(); bindMenu();
    });
  });
  document.querySelectorAll('.bm-sub-chip').forEach(el=>{
    el.addEventListener('click', e=>{
      e.stopPropagation();
      const wrap=el.closest('.bm-sub-chips');
      const sec=wrap.getAttribute('data-sec'), item=wrap.getAttribute('data-item');
      const sub=el.getAttribute('data-sub');
      toggleSub(sec,item,sub);
      document.getElementById('bmBody').innerHTML=htmlMenu(); bindMenu();
    });
  });
  document.querySelectorAll('.bm-patty-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      S.patty = btn.getAttribute('data-patty');
      document.getElementById('bmBody').innerHTML = htmlMenu();
      bindMenu();
    });
  });
  bindCascade();
  bindCustom();
}

function bindCascade() {
  document.querySelectorAll('.bm-cascade-select').forEach(el=>{
    el.addEventListener('change', ()=>{
      const key  = el.getAttribute('data-cascade-key');
      const sec  = el.getAttribute('data-sec');
      const item = el.getAttribute('data-item');
      const arr  = S.menuSel[sec];
      if (!arr) return;
      const entry = arr.find(x=>x.item===item);
      if (!entry) return;
      entry.cascadeChoices[key] = el.value;
      const itDef = findItemDef(sec, item);
      if (itDef?.cascade) {
        const keyIdx = itDef.cascade.findIndex(c=>c.question===key);
        for (let i = keyIdx+1; i < itDef.cascade.length; i++) {
          entry.cascadeChoices[itDef.cascade[i].question] = '';
        }
      }
      document.getElementById('bmBody').innerHTML=htmlMenu(); bindMenu();
    });
  });
}

function bindCustom() {
  document.querySelectorAll('.bm-custom-add').forEach(el=>{
    el.addEventListener('click', ()=>{
      const sec = el.getAttribute('data-sec');
      if (!S.menuSel[sec]) S.menuSel[sec] = [];
      S.menuSel[sec].push({ item:'__custom__', subOptions:[], isCustom:true });
      document.getElementById('bmBody').innerHTML=htmlMenu(); bindMenu();
    });
  });
  document.querySelectorAll('.bm-custom-existing').forEach(el=>{
    let timer;
    el.addEventListener('input', ()=>{
      const sec = el.getAttribute('data-sec');
      const idx = parseInt(el.getAttribute('data-custom-idx'));
      clearTimeout(timer);
      timer = setTimeout(()=>{
        const arr = S.menuSel[sec];
        if (arr && arr[idx]) arr[idx].item = '__custom__' + el.value;
      }, 300);
    });
  });
  document.querySelectorAll('.bm-custom-remove').forEach(el=>{
    el.addEventListener('click', ()=>{
      const sec = el.getAttribute('data-sec');
      const idx = parseInt(el.getAttribute('data-custom-idx'));
      const arr = S.menuSel[sec];
      if (arr) arr.splice(idx, 1);
      document.getElementById('bmBody').innerHTML=htmlMenu(); bindMenu();
    });
  });
}

function htmlDrinks() {
  return `<p class="bm-step-desc">Möchten Sie eine Getränkepauschale dazubuchen?</p>
  <div class="bm-drink-cards">${DRINKS.map(d=>`
    <div class="bm-cat-card${S.drink===d.id?' bm-selected':''}" data-drink="${d.id}">
      <div class="bm-cat-name">${d.name}</div>
      <div class="bm-cat-desc">${d.desc}</div>
    </div>`).join('')}</div>`;
}

function bindDrinks() {
  document.querySelectorAll('.bm-drink-cards .bm-cat-card').forEach(el=>{
    el.addEventListener('click',()=>{
      S.drink = el.getAttribute('data-drink');
      document.querySelectorAll('.bm-drink-cards .bm-cat-card').forEach(c=>c.classList.remove('bm-selected'));
      el.classList.add('bm-selected');
    });
  });
}

function htmlGeschirrSaeuberung() {
  return `<p class="bm-step-desc">Bitte treffen Sie Ihre Auswahl zu Geschirr und Säuberung.</p>
  <div class="bm-choice-group">
    <p class="bm-field-group-label">Geschirr</p>
    <div class="bm-choice-grid">${GESCHIRR_OPTIONS.map(opt=>`
      <div class="bm-cat-card bm-choice-card${S.geschirr===opt?' bm-selected':''}" data-geschirr="${esc(opt)}">
        <div class="bm-cat-name">${opt}</div>
      </div>`).join('')}</div>
  </div>
  <div class="bm-choice-group">
    <p class="bm-field-group-label">Säuberung</p>
    <div class="bm-choice-grid">${SAEUBERUNG_OPTIONS.map(opt=>`
      <div class="bm-cat-card bm-choice-card${S.saeuberung===opt.id?' bm-selected':''}" data-saeuberung="${esc(opt.id)}">
        <div class="bm-cat-name">${opt.name}</div>
        ${opt.hint ? `<div class="bm-cat-desc">${opt.hint}</div>` : ''}
      </div>`).join('')}</div>
  </div>`;
}

function bindGeschirrSaeuberung() {
  document.querySelectorAll('[data-geschirr]').forEach(el=>{
    el.addEventListener('click',()=>{
      S.geschirr = el.getAttribute('data-geschirr');
      document.querySelectorAll('[data-geschirr]').forEach(c=>c.classList.remove('bm-selected'));
      el.classList.add('bm-selected');
    });
  });
  document.querySelectorAll('[data-saeuberung]').forEach(el=>{
    el.addEventListener('click',()=>{
      S.saeuberung = el.getAttribute('data-saeuberung');
      document.querySelectorAll('[data-saeuberung]').forEach(c=>c.classList.remove('bm-selected'));
      el.classList.add('bm-selected');
    });
  });
}

function htmlWishes() {
  return `<p class="bm-step-desc">Haben Sie besondere Wünsche, Allergien oder sonstige Anmerkungen?</p>
  <div class="bm-wishes-wrap">
    <textarea id="bfWishes" placeholder="z.B. vegane Optionen, Nussallergien, besondere Dekoration...">${S.wishes}</textarea>
    <p class="bm-hint">Alle Angaben sind unverbindlich. Wir prüfen Ihre Wünsche und melden uns bei Bedarf für Details.</p>
  </div>`;
}

function bindWishes() {
  document.getElementById('bfWishes')?.addEventListener('input',e=>{S.wishes=e.target.value;});
}

function htmlSummary() {
  const cat  = CATS.find(c=>c.id===S.category);
  const menu = MENU[S.category];
  const row  = (k,v)=>`<div class="bm-summary-row"><span class="bm-row-key">${k}</span><span class="bm-row-val">${v}</span></div>`;

  const menuHtml = (menu?.sections || []).filter(secDef=>(S.menuSel[secDef.title]||[]).length>0).map(secDef=>{
    const arr   = S.menuSel[secDef.title];
    const lines = arr.map(e=>{
      if (e.isCustom) {
        const displayName = e.item.replace(/^__custom__/,'');
        return `<div class="bm-summary-row"><span class="bm-row-key">—</span><span class="bm-row-val">(Eigener Wunsch) ${displayName}</span></div>`;
      }
      const itDef     = secDef.items.find(i=>i.label===e.item);
      const badgePart = itDef?.badge ? ` <span style="color:#488d94;font-size:0.72rem">(${itDef.badge})</span>` : '';
      const subPart   = e.subOptions.length ? ` → ${e.subOptions.join(', ')}` : '';
      let cascadePart = '';
      if (e.cascadeChoices) {
        const choices = Object.entries(e.cascadeChoices).filter(([,v])=>v).map(([k,v])=>`${k}: ${v}`).join(' | ');
        if (choices) cascadePart = ` → ${choices}`;
      }
      return `<div class="bm-summary-row"><span class="bm-row-key">—</span><span class="bm-row-val">${e.item}${subPart}${cascadePart}${badgePart}</span></div>`;
    }).join('');
    return `<div class="bm-summary-block"><div class="bm-summary-title">${secDef.title}</div>${lines}</div>`;
  }).join('');

  return `
    <div class="bm-summary-block"><div class="bm-summary-title">Veranstaltung</div>
      ${row('Catering-Art',cat.name)}${row('Datum',S.date||'–')}${row('Ort',S.location||'–')}${row('Personen',S.persons+' Personen')}
    </div>
    ${menuHtml || `<div class="bm-summary-block"><div class="bm-summary-title">Menü</div>${row('—','Keine Auswahl getroffen')}</div>`}
    ${S.category === 'truck' && S.patty ? `<div class="bm-summary-block"><div class="bm-summary-title">Patty-Wahl</div>${row('Patty',S.patty)}</div>` : ''}
    <div class="bm-summary-block"><div class="bm-summary-title">Getränke</div>
      ${row('Getränkepauschale', DRINKS.find(d=>d.id===S.drink)?.name || '–')}
    </div>
    <div class="bm-summary-block"><div class="bm-summary-title">Geschirr & Säuberung</div>
      ${row('Geschirr', S.geschirr || '–')}${row('Säuberung', saeuberungLabel(S.saeuberung) || '–')}
    </div>
    <div class="bm-summary-block"><div class="bm-summary-title">Kontakt</div>
      ${row('Name',S.name||'–')}${row('E-Mail',S.email||'–')}${S.phone?row('Telefon',S.phone):''}
    </div>
    ${S.wishes?`<div class="bm-summary-block"><div class="bm-summary-title">Individuelle Wünsche</div><div class="bm-summary-row"><span class="bm-row-val" style="text-align:left">${S.wishes}</span></div></div>`:''}
    <p class="bm-privacy-note">Mit dem Absenden stimmen Sie der Verarbeitung Ihrer Daten gemäß unserer <a href="/datenschutz" target="_blank" rel="noopener noreferrer">Datenschutzerklärung</a> zu.</p>`;
}

function validate() {
  if(S.step===1&&!S.category){alert('Bitte wählen Sie eine Catering-Art.');return false;}
  if(S.step===2){
    if(!S.persons||S.persons<1){alert('Bitte Personenanzahl angeben.');return false;}
    if(!S.date){alert('Bitte Datum angeben.');return false;}
    if(!S.location){alert('Bitte Veranstaltungsort angeben.');return false;}
    if(!S.name){alert('Bitte Namen angeben.');return false;}
    if(!S.email||!S.email.includes('@')){alert('Bitte gültige E-Mail angeben.');return false;}
  }
  if(S.step===3){
    const total=Object.values(S.menuSel).reduce((a,arr)=>a+arr.length,0);
    if(total<1){alert('Bitte mindestens ein Gericht auswählen.');return false;}
  }
  if(S.step===5){
    if(!S.geschirr){alert('Bitte wählen Sie eine Geschirr-Option.');return false;}
    if(!S.saeuberung){alert('Bitte wählen Sie eine Säuberungs-Option.');return false;}
  }
  return true;
}

async function submit() {
  const cat  = CATS.find(c => c.id === S.category);
  const menu = MENU[S.category];

  const menuText = (menu?.sections || [])
    .filter(sec => (S.menuSel[sec.title] || []).length > 0)
    .map(secDef => {
      const arr   = S.menuSel[secDef.title];
      const lines = arr.map(e=>{
        if (e.isCustom) {
          const displayName = e.item.replace(/^__custom__/,'');
          if (!displayName) return null;
          return `  — [Eigener Wunsch] ${displayName}`;
        }
        const itDef     = secDef.items.find(i=>i.label===e.item);
        const badgePart = itDef?.badge ? ` (${itDef.badge})` : '';
        const subPart   = e.subOptions.length ? ` → ${e.subOptions.join(', ')}` : '';
        let cascadePart = '';
        if (e.cascadeChoices) {
          const choices = Object.entries(e.cascadeChoices).filter(([,v])=>v).map(([k,v])=>`${k}: ${v}`).join(' | ');
          if (choices) cascadePart = ` → ${choices}`;
        }
        return `  — ${e.item}${subPart}${cascadePart}${badgePart}`;
      }).filter(Boolean).join('\n');
      return `${secDef.title}:\n${lines}`;
    }).join('\n') || '–';

  const fields = {
    'form-name':       'banketmappe',
    'kontakt_name':    S.name,
    'datum':           S.date,
    'personen':        String(S.persons),
    'ort':             S.location,
    'kategorie':       cat.name,
    'menu_auswahl':    menuText,
  };
  if (S.category === 'truck') fields['patty'] = S.patty || 'Nicht angegeben';
  fields['getraenke']       = DRINKS.find(d=>d.id===S.drink)?.name || '–';
  fields['geschirr']        = S.geschirr || '–';
  fields['saeuberung']      = saeuberungLabel(S.saeuberung) || '–';
  fields['wuensche']        = S.wishes || 'Keine';
  fields['kontakt_email']   = S.email;
  fields['kontakt_telefon'] = S.phone || '–';

  const payload = new URLSearchParams(fields);

  try {
    const res = await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: payload.toString(),
    });

    if (res.ok) {
      document.getElementById('bmCard').style.display = 'none';
      document.getElementById('bmSuccess').classList.add('bm-visible');
    } else {
      alert('Fehler beim Senden. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt: kontakt@velaro-catering.de');
    }
  } catch (err) {
    alert('Verbindungsfehler. Bitte prüfen Sie Ihre Internetverbindung.');
  }
}

document.getElementById('bmNext')?.addEventListener('click',()=>{
  if(S.step===TOTAL_STEPS){submit();return;}
  if(!validate())return;
  S.step++; render();
  document.getElementById('banketmappe')?.scrollIntoView({behavior:'smooth',block:'start'});
});

document.getElementById('bmBack')?.addEventListener('click',()=>{
  if(S.step>0){S.step--;render();document.getElementById('banketmappe')?.scrollIntoView({behavior:'smooth',block:'start'});}
});

document.getElementById('bmReset')?.addEventListener('click',()=>{
  Object.assign(S,{step:0,category:'',persons:30,date:'',location:'',name:'',email:'',phone:'',menuSel:{},drink:'none',geschirr:'',saeuberung:'',wishes:''});
  document.getElementById('bmCard').style.display='';
  document.getElementById('bmSuccess').classList.remove('bm-visible');
  render();
});

render();
</script>