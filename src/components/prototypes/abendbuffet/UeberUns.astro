---
// UeberUns.astro — Abendbuffet Prototype
// Quelle: src/pages/index.astro (About Split)
---

<section class="ab-section ab-ueber" id="ueber-uns" aria-label="Über Velaro">
  <div class="ab-container ab-ueber-grid">

    <!-- Left: Text -->
    <div class="ab-reveal ab-ueber-text">
      <span class="ab-eyebrow">Über Velaro</span>
      <h2 class="ab-h2" style="margin-top: 1.5rem;">
        Kulinarik mit<br>Charakter —<br><em>seit Tag eins.</em>
      </h2>

      <div class="ab-ueber-body">
        <p class="ab-body">
          Velaro steht für ein Catering, das mehr will als nur satt machen.
          Wir kombinieren die Geradlinigkeit moderner Streetfood-Küche mit
          dem Anspruch eleganter Bankett-Tradition.
        </p>
        <p class="ab-body">
          Jedes Gericht — vom Canapé bis zum Festtagsbuffet — wird frisch
          in unserer Manufaktur in Haldensleben zubereitet und am Eventtag
          persönlich von uns serviert.
        </p>
      </div>

      <hr class="ab-rule ab-ueber-rule" />

      <div class="ab-ueber-stats">
        <div class="ab-stat">
          <div class="ab-stat-num">100%</div>
          <div class="ab-label" style="margin-top: 0.5rem;">Frisch zubereitet</div>
        </div>
        <div class="ab-stat">
          <div class="ab-stat-num">2012</div>
          <div class="ab-label" style="margin-top: 0.5rem;">Seit über 12 Jahren</div>
        </div>
      </div>

      <a href="#leistungen" class="ab-btn-ghost" style="margin-top: 1.5rem;">
        Unsere Leistungen ansehen →
      </a>
    </div>

    <!-- Right: Media + quote badge -->
    <div class="ab-reveal ab-ueber-media">
      <div class="ab-ueber-img-wrap">
        <img
          src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?q=80&w=1200&auto=format&fit=crop"
          alt="Velaro Manufaktur — Haldensleben"
          loading="lazy"
          width="1200"
          height="1500"
        />
        <!-- Cream warm overlay at bottom -->
        <div class="ab-ueber-img-fade" aria-hidden="true"></div>
      </div>

      <!-- Quote badge, positioned over photo -->
      <div class="ab-ueber-quote">
        <span class="ab-ueber-quote-mark">"</span>
        <p>Ein Catering, das Persönlichkeit hat — und das schmeckt man in jedem Bissen.</p>
        <span class="ab-label ab-ueber-quote-attr">
          [TODO: Referenz / Kundenstimme eintragen]
        </span>
      </div>
    </div>

  </div>
</section>

<style>
  .ab-ueber {
    background: var(--ab-bg);
    position: relative;
  }

  /* Subtle cream glow from left side */
  .ab-ueber::before {
    content: '';
    position: absolute;
    left: -10%;
    top: 20%;
    width: 50%;
    height: 60%;
    background: radial-gradient(ellipse, rgba(243,235,220,0.05), transparent 65%);
    pointer-events: none;
  }

  .ab-ueber-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  /* ── Left ── */
  .ab-ueber-text {
    display: flex;
    flex-direction: column;
  }

  .ab-ueber-body {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ab-ueber-rule {
    margin-block: 2.5rem;
  }

  .ab-ueber-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .ab-stat { display: flex; flex-direction: column; }

  /* ── Right: Media ── */
  .ab-ueber-media {
    position: relative;
  }

  .ab-ueber-img-wrap {
    position: relative;
    border-radius: var(--ab-r-lg);
    overflow: hidden;
    height: clamp(460px, 68vh, 680px);
    box-shadow:
      0 8px 48px rgba(0,0,0,0.4),
      0 0 0 1px var(--ab-glow-xs);
  }

  .ab-ueber-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }

  .ab-ueber-img-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 55%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(8,17,29,0.65) 100%
    );
    pointer-events: none;
  }

  /* Quote badge — over the photo, bottom left */
  .ab-ueber-quote {
    position: absolute;
    bottom: 2rem;
    left: 1.75rem;
    right: 1.75rem;
    padding: 1.75rem 1.75rem 1.5rem;
    background: rgba(8,17,29,0.72);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-radius: var(--ab-r);
    border: 1px solid rgba(243,235,220,0.08);
    box-shadow:
      0 4px 24px rgba(0,0,0,0.3),
      inset 0 0 0 1px rgba(243,235,220,0.04);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ab-ueber-quote-mark {
    font-family: var(--ab-serif);
    font-style: italic;
    font-size: 2.4rem;
    color: var(--ab-cream);
    line-height: 0.6;
    opacity: 0.6;
  }

  .ab-ueber-quote p {
    font-family: var(--ab-serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--ab-text);
  }

  .ab-ueber-quote-attr {
    opacity: 0.5;
    font-size: 0.65rem;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .ab-ueber-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .ab-ueber-media { order: -1; }

    .ab-ueber-img-wrap {
      height: clamp(300px, 55vw, 460px);
    }
  }
</style>
