---
// Leistungen.astro — Abendbuffet Prototype
// Quelle: src/components/Banketmappe.astro (CATS data)

const leistungen = [
  {
    tag: 'Buffet',
    name: 'Klassisches Buffet',
    desc: 'Warme & kalte Speisen für jeden Anlass — individuell auf Ihre Gästezahl und Wünsche abgestimmt.',
    img: 'https://images.unsplash.com/photo-1555244162-803834f70033?q=80&w=900&auto=format&fit=crop',
    alt: 'Klassisches Catering-Buffet',
    href: '/catering',
  },
  {
    tag: 'Grill',
    name: 'Grillbuffet',
    desc: 'Frisch vom Grill — deftig & gesellig. Das richtige Catering für entspannte Gartenpartys und Firmenfeiern.',
    img: 'https://images.unsplash.com/photo-1529193591184-b1d58069ecdd?q=80&w=900&auto=format&fit=crop',
    alt: 'Grillbuffet mit frisch gegrillten Speisen',
    href: '/catering',
  },
  {
    tag: 'Fingerfood',
    name: 'Kleine Speisen',
    desc: 'Wraps, Canapés & Fingerfood — ab 10 Personen. Ideal für Sektempfänge, Ausstellungen und alle, die stilsicher feiern.',
    img: 'https://images.unsplash.com/photo-1484723091739-30a097e8f929?q=80&w=900&auto=format&fit=crop',
    alt: 'Fingerfood und Canapés',
    href: '/catering',
  },
  {
    tag: 'Food Truck',
    name: 'Food Truck Catering',
    desc: 'Saftige Burger direkt zu Ihrem Event — unser Food Truck bringt Street-Food-Feeling auf jede Veranstaltung.',
    img: 'https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?q=80&w=900&auto=format&fit=crop',
    alt: 'Velaro Food Truck Catering',
    href: '/maerkte',
  },
];
---

<section class="ab-section ab-leistungen" id="leistungen" aria-label="Unsere Leistungen">
  <div class="ab-container">

    <!-- Section header -->
    <div class="ab-reveal ab-leistungen-header">
      <span class="ab-eyebrow">Unsere Leistungen</span>
      <h2 class="ab-h2" style="margin-top: 1.25rem;">
        Vier Wege zum<br><em>unvergesslichen Abend.</em>
      </h2>
      <p class="ab-body ab-leistungen-lead">
        Von der stillen Geburtstagsfeier bis zur großen Firmenveranstaltung —
        wir passen uns Ihrem Anlass an, nicht umgekehrt.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="ab-leistungen-grid ab-reveal-stagger">
      {leistungen.map((l) => (
        <a href={l.href} class="ab-card ab-leistungen-card" aria-label={l.name}>
          <div class="ab-card-img">
            <img src={l.img} alt={l.alt} loading="lazy" width="900" height="506" />
          </div>
          <div class="ab-card-body">
            <span class="ab-leistungen-tag ab-label">{l.tag}</span>
            <h3 class="ab-h3" style="margin-top: 0.65rem;">{l.name}</h3>
            <p class="ab-body ab-leistungen-desc">{l.desc}</p>
            <span class="ab-btn-ghost ab-leistungen-link">
              Mehr erfahren →
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="ab-reveal ab-leistungen-bottom">
      <p class="ab-body">
        Noch nicht das Richtige gefunden? Unsere interaktive Banketmappe
        hilft Ihnen, Ihr Wunsch-Catering in wenigen Schritten zusammenzustellen.
      </p>
      <a href="/catering" class="ab-btn ab-btn-primary">
        Banketmappe öffnen →
      </a>
    </div>

  </div>
</section>

<style>
  .ab-leistungen {
    background: var(--ab-bg-deep);
    position: relative;
  }

  /* Subtle warm glow from bottom-right — candlelight gegenlicht */
  .ab-leistungen::after {
    content: '';
    position: absolute;
    bottom: -5%;
    right: -5%;
    width: 50%;
    height: 50%;
    background: radial-gradient(ellipse, rgba(243,235,220,0.04), transparent 65%);
    pointer-events: none;
  }

  .ab-leistungen-header {
    max-width: 680px;
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  .ab-leistungen-lead {
    margin-top: 1.5rem;
    max-width: 55ch;
    font-size: 1.05rem;
  }

  /* 2 × 2 grid on desktop */
  .ab-leistungen-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .ab-leistungen-card {
    display: flex;
    flex-direction: column;
    cursor: pointer;
    text-decoration: none;
  }

  .ab-leistungen-tag {
    display: inline-block;
    color: var(--ab-accent);
  }

  .ab-leistungen-desc {
    margin-top: 0.85rem;
    font-size: 0.95rem;
    line-height: 1.75;
    max-width: 52ch;
  }

  .ab-leistungen-link {
    margin-top: 1.5rem;
    display: inline-flex;
  }

  /* Bottom CTA strip */
  .ab-leistungen-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: clamp(4rem, 7vw, 6rem);
    padding-top: 3rem;
    border-top: 1px solid rgba(243,235,220,0.07);
  }

  .ab-leistungen-bottom .ab-body {
    max-width: 54ch;
    flex: 1;
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .ab-leistungen-grid { grid-template-columns: 1fr; }
    .ab-leistungen-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
