<section class="mkref">
  <div class="mk-container">

    <div class="mkref-pull mk-reveal">
      <div class="mkref-open" aria-hidden="true">"</div>
      <div class="mkref-body">
        <blockquote class="mkref-quote">
          Ein Catering, das Persönlichkeit hat — und es schmeckt man in jedem Bissen.
        </blockquote>
        <footer class="mkref-foot">
          <span class="mk-eyebrow">Kundenstimme</span>
          <cite class="mkref-cite">[TODO: Kundenname, Veranstaltungsart]</cite>
        </footer>
      </div>
    </div>

    <div class="mkref-stats mk-reveal-stagger">
      <div class="mkref-stat">
        <div class="mkref-stat-k">12+</div>
        <div class="mkref-stat-v">Jahre Erfahrung</div>
      </div>
      <div class="mkref-stat">
        <div class="mkref-stat-k">400+</div>
        <div class="mkref-stat-v">Events &amp; Märkte</div>
      </div>
      <div class="mkref-stat">
        <div class="mkref-stat-k">100%</div>
        <div class="mkref-stat-v">Frisch zubereitet</div>
      </div>
      <div class="mkref-stat">
        <div class="mkref-stat-k">&lt;&nbsp;24h</div>
        <div class="mkref-stat-v">Antwortzeit</div>
      </div>
    </div>

    <p class="mkref-todo">
      [TODO: Referenzfotos &amp; weitere Kundenstimmen ergänzen]
    </p>

  </div>
</section>

<style is:global>
.mkref {
  background: var(--mk-cream);
  padding-block: clamp(4rem, 8vw, 6rem);
  border-top: 1px solid rgba(8,17,29,0.1);
}

.mkref-pull {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 2.5rem;
  align-items: start;
  max-width: 940px;
  margin-inline: auto;
  padding-bottom: 3.5rem;
  border-bottom: 1px solid rgba(8,17,29,0.12);
  margin-bottom: 4rem;
}
.mkref-open {
  font-family: var(--mk-serif);
  font-weight: 600;
  font-style: normal;
  font-size: 7rem;
  line-height: 0.65;
  color: var(--mk-accent);
  user-select: none;
  flex-shrink: 0;
}
.mkref-body {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.mkref-quote {
  font-family: var(--mk-serif);
  font-weight: 600;
  font-style: normal;
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  line-height: 1.15;
  color: var(--mk-bg-deep);
}
.mkref-foot {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}
.mkref-cite {
  font-style: normal;
  font-size: 0.88rem;
  color: rgba(8,17,29,0.45);
}

/* ── Stats grid ── */
.mkref-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--mk-bg-deep);
  box-shadow: 4px 4px 0 var(--mk-bg-deep);
  margin-bottom: 2rem;
}
.mkref-stat {
  padding: 1.75rem;
  border-right: 1px solid var(--mk-bg-deep);
  background: var(--mk-cream);
}
.mkref-stat:last-child { border-right: none; }
.mkref-stat-k {
  font-family: var(--mk-serif);
  font-weight: 600;
  font-style: normal;
  font-size: 2.5rem;
  line-height: 1;
  color: var(--mk-bg-deep);
}
.mkref-stat-v {
  font-family: var(--mk-sans);
  font-weight: 700;
  font-size: 0.62rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(8,17,29,0.45);
  margin-top: 0.375rem;
}

.mkref-todo {
  font-size: 0.78rem;
  color: rgba(8,17,29,0.3);
  text-align: center;
  padding: 0.875rem 1.5rem;
  border: 1px dashed rgba(8,17,29,0.18);
}

@media (max-width: 860px) {
  .mkref-pull  { grid-template-columns: 1fr; gap: 1rem; }
  .mkref-open  { font-size: 4.5rem; }
  .mkref-stats { grid-template-columns: 1fr 1fr; }
  .mkref-stat:nth-child(2)  { border-right: none; }
  .mkref-stat:nth-child(3),
  .mkref-stat:nth-child(4)  { border-top: 1px solid var(--mk-bg-deep); }
}
@media (max-width: 480px) {
  .mkref-stats { grid-template-columns: 1fr; }
  .mkref-stat  { border-right: none !important; border-bottom: 1px solid var(--mk-bg-deep); }
  .mkref-stat:last-child { border-bottom: none; }
}
</style>
