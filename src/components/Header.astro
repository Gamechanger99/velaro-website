---
const navLinks = [
  { href: '/',         label: 'Start'    },
  { href: '/catering', label: 'Catering' },
  { href: '/maerkte',  label: 'Märkte'   },
  { href: '/kontakt',  label: 'Kontakt'  },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="siteHeader">
  <div class="container header-inner">

    <a href="/" class="logo-link" aria-label="Velaro Startseite">
      <img src="/logo.svg" alt="Velaro Catering" class="logo-img" />
    </a>

    <nav>
      <ul class="nav-list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { 'nav-link--active': currentPath === link.href }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/kontakt" class="nav-cta">Anfragen</a>

    <button class="hamburger" id="hamburger" aria-label="Menü öffnen">
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <nav class="mobile-nav" id="mobileNav">
    {navLinks.map(link => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 1rem 0;
    transition: background-color var(--t), backdrop-filter var(--t), border-color var(--t), padding var(--t);
    border-bottom: 1px solid transparent;
  }
  .site-header.scrolled {
    background: rgba(11,20,33,0.78);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border-bottom-color: var(--border-soft);
    padding: 0.5rem 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo-link { display: flex; align-items: center; }
  .logo-img  { height: 56px; width: auto; mix-blend-mode: screen; transition: transform var(--t); }
  .logo-link:hover .logo-img { transform: scale(1.04); }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    transition: color var(--t);
  }
  .nav-link::before {
    content: '';
    position: absolute;
    left: 1.1rem; right: 1.1rem;
    bottom: 0.25rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 280ms var(--ease);
  }
  .nav-link:hover          { color: var(--text); }
  .nav-link:hover::before  { transform: scaleX(1); }
  .nav-link--active        { color: var(--text); }
  .nav-link--active::before { transform: scaleX(1); }

  .nav-cta {
    margin-left: 0.75rem;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    background: var(--accent);
    color: #08111d;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: all var(--t);
  }
  .nav-cta:hover {
    background: var(--cream);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -8px var(--accent-glow);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
  }
  .hamburger span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--text);
    transition: transform var(--t), opacity var(--t);
  }

  .mobile-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0; right: 0;
    background: rgba(11,20,33,0.97);
    backdrop-filter: blur(20px);
    border-top: 1px solid var(--border-soft);
    padding: 1rem 1.5rem 1.5rem;
  }
  .mobile-nav.is-open { display: block; }
  .mobile-nav a {
    display: block;
    padding: 1rem 0;
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--text);
    border-bottom: 1px solid var(--border-soft);
  }
  .mobile-nav a:last-child { border-bottom: none; }

  @media (max-width: 860px) {
    .nav-list, .nav-cta { display: none; }
    .hamburger { display: flex; }
  }
</style>
