  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© 2026 Velaro Catering & Foodtruckservice</p>
      <div class="footer-legal">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-nav);
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr;
    gap: 3rem;
    padding-block: 3rem;
  }

  /* Brand */
  .footer-logo {
    height: 3rem;
    width: auto;
    mix-blend-mode: screen;
    margin-bottom: 0.75rem;
  }

  .footer-brand p {
    font-size: 0.85rem;
    line-height: 1.7;
  }

  /* Columns */
  .footer-col h4 {
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-col li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .footer-col svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .footer-col a {
    color: var(--color-text-muted);
    transition: color var(--transition);
  }

  .footer-col a:hover { color: var(--color-accent); }

  /* Öffnungszeiten */
  .hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Bottom */
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-block: 1rem;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom p { font-size: 0.8rem; color: var(--color-text-muted); }

  .footer-legal { 
  display: flex; 
  gap: 2rem;  /* mehr Abstand */
}

.footer-legal a {
  color: var(--color-text-muted);
  font-size: 0.8rem;
  transition: color var(--transition);
  position: relative;
}

/* Hover: Unterstrich fährt rein */
.footer-legal a::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 1px;
  background-color: var(--color-accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 200ms ease;
}

.footer-legal a:hover {
  color: var(--color-text);
}

.footer-legal a:hover::after {
  transform: scaleX(1);
}

  @media (max-width: 767px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 2rem;
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>